---
import { getCollection, type CollectionEntry } from 'astro:content';
import StatusBadge from '../../components/StatusBadge.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { featuredArtifact, formatDate, formatLabel, getProjectFolder, loadArtifacts, publicOnlyBuild, withBase } from '../../lib/projects';
import RemoteEditor from '../../components/RemoteEditor.astro';
import PrivateVault from '../../components/PrivateVault.astro';
import { privacyLevels, projectStatuses } from '../../lib/project-schema';

export async function getStaticPaths() {
  // Private projects build too: in public deploys they are generated locked stubs.
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.data.slug }, props: { project } }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data } = project;
const artifacts = await loadArtifacts(project);
const privateProject = data.privacy === 'private';
const projectFolder = await getProjectFolder(project);
const heroArtifact = featuredArtifact(project, artifacts);
const lockedView = publicOnlyBuild && privateProject;
const inlineEditable = publicOnlyBuild && !privateProject;

const pencil = `<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.85 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"></path></svg>`;
---

<BaseLayout title={data.name} description={data.description}>
  <div class="page-shell project-page">
    <a class="back-link" href={withBase('/')}>← Portfolio index</a>

    <header class="project-hero">
      <div class="project-hero__main">
        <div class="project-hero__topline"><span class="project-id">{data.id}</span><StatusBadge status={data.status} /></div>
        <div class="inline-editable">
          <h1 data-field-display="name">{data.name}</h1>
          {inlineEditable && <button type="button" class="inline-edit" data-inline-edit="name" aria-label="Edit the name" set:html={pencil} />}
        </div>
        <div class="inline-editable">
          <p data-field-display="description">{data.description}</p>
          {inlineEditable && <button type="button" class="inline-edit" data-inline-edit="description" aria-label="Edit the description" set:html={pencil} />}
        </div>
      </div>
      <aside class={`confidentiality-card confidentiality-card--${data.privacy}`}>
        <span class="confidentiality-card__icon" aria-hidden="true">◆</span>
        <div><small>Privacy</small><strong>{formatLabel(data.privacy)}</strong><p>{data.privacy === 'private' ? 'Only for you.' : 'Ready to share.'}</p></div>
      </aside>
    </header>

    <dl class="metadata-strip">
      <div class="inline-editable">
        <dt>Status</dt>
        <dd data-field-display="status" data-value={data.status}>{formatLabel(data.status)}</dd>
        {inlineEditable && <button type="button" class="inline-edit" data-inline-edit="status" aria-label="Edit the status" set:html={pencil} />}
      </div>
      <div class="inline-editable">
        <dt>Started</dt>
        <dd data-field-display="startDate" data-value={data.startDate.toISOString().slice(0, 10)}><time datetime={data.startDate.toISOString()}>{formatDate(data.startDate)}</time></dd>
        {inlineEditable && <button type="button" class="inline-edit" data-inline-edit="startDate" aria-label="Edit the start date" set:html={pencil} />}
      </div>
      <div><dt>Updated</dt><dd><time datetime={data.updatedDate.toISOString()}>{formatDate(data.updatedDate)}</time></dd></div>
    </dl>

    {!lockedView && (
    <nav class="section-nav" aria-label="Project sections"><a href="#overview">Overview</a><a href="#artifacts">Artifacts <span>{artifacts.length}</span></a></nav>
    )}

    {lockedView && <PrivateVault id={data.id} />}

    {publicOnlyBuild && !privateProject && <RemoteEditor project={project} folder={projectFolder} />}

    {!publicOnlyBuild && (
    <section class="project-editor" aria-labelledby="project-editor-title">
      <div class="project-editor__intro">
        <div><p class="eyebrow">Local editor</p><h2 id="project-editor-title">Manage this project</h2></div>
        <p>{privateProject ? 'Device unlock is required before editing this private project.' : "Changes are saved directly to this project's Markdown record."}</p>
      </div>
      <p class="project-editor__auth-status" data-project-auth-status aria-live="polite" hidden></p>
      <div class="project-editor__tools">
        <details class="project-edit-details" data-project-edit-details data-private={String(privateProject)}>
          <summary data-protected-project-control={privateProject ? 'true' : undefined} data-unlocked-label="Edit project details">
            {privateProject ? (
              <svg class="project-control-lock" aria-hidden="true" viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="11" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"></path></svg>
            ) : <span aria-hidden="true">✦</span>}
            <span data-protected-label>{privateProject ? 'Unlock project editor' : 'Edit project details'}</span>
          </summary>
          <form class="compact-form project-edit-form" data-project-edit-form data-project-slug={data.slug} novalidate>
            <div class="compact-ai-fill" data-edit-ai-panel>
              <div><strong>Update from a repository</strong><p>AI inspects the code and drafts changes. Nothing is saved until you press “Save changes.”</p></div>
              <div class="compact-ai-fill__repository">
                <label class="field"><span>Repository address</span><input type="url" data-edit-repository-url maxlength="500" inputmode="url" autocapitalize="none" autocomplete="off" placeholder="https://github.com/owner/repository" /></label>
                <div class="compact-ai-fill__actions"><button type="button" data-edit-repository-mode="strict">Analyze exact facts</button><button type="button" data-edit-repository-mode="inferred">Analyze + infer why</button></div>
                <div class="repository-auth" data-edit-repository-auth hidden></div>
              </div>
              <p class="ai-fill-result" data-edit-ai-result aria-live="polite"></p>
            </div>

            <label class="field"><span>Name</span><input name="name" value={data.name} required maxlength="120" /></label>
            <label class="field"><span>Description</span><textarea name="description" required maxlength="500" rows="3">{data.description}</textarea></label>
            <label class="field"><span>Why it was built</span><textarea name="why" required maxlength="3000" rows="8">{data.why}</textarea></label>
            <div class="form-grid form-grid--two">
              <label class="field"><span>Status</span><select name="status" required>{projectStatuses.map((value) => <option value={value} selected={value === data.status}>{formatLabel(value)}</option>)}</select></label>
              <label class="field"><span>Privacy</span><select name="privacy" required>{privacyLevels.map((value) => <option value={value} selected={value === data.privacy}>{formatLabel(value)}</option>)}</select></label>
              <label class="field"><span>Start date</span><input name="startDate" type="date" value={data.startDate.toISOString().slice(0, 10)} required /></label>
            </div>
            <div class="compact-form__actions"><p class="form-status" data-project-edit-status aria-live="assertive"></p><button class="primary-button" type="submit">Save changes</button></div>
          </form>
        </details>

      </div>
    </section>
    )}

    {!lockedView && (
    <article class="case-study" id="overview">
      <div class="section-kicker"><span>01</span> Overview</div>
      <div class="section-heading section-heading--detail"><div><h2>Why it was built</h2></div></div>
      <div class="prose inline-editable">
        <p data-field-display="why">{data.why}</p>
        {inlineEditable && <button type="button" class="inline-edit" data-inline-edit="why" aria-label="Edit why it was built" set:html={pencil} />}
      </div>
    </article>
    )}

    {!lockedView && (
    <section class="artifacts-section" id="artifacts" {...(publicOnlyBuild ? {} : { 'data-media-section': true, 'data-project-slug': data.slug })}>
      <div class="section-kicker"><span>02</span> Supporting artifacts</div>
      <div class="section-heading section-heading--detail">
        <div>
          <h2>Evidence from the work</h2>
          <p>
            {publicOnlyBuild
              ? 'Images, documents, and recordings stored alongside this project.'
              : 'Images, documents, and recordings stored alongside this project. Drop files onto the carousel to add them, drag the tiles to reorder.'}
          </p>
          <button type="button" class="media-add-button" {...(publicOnlyBuild ? { 'data-remote-media-open': true } : { 'data-media-browse': true })}>＋ Add media</button>
        </div>
      </div>
      {!publicOnlyBuild && <input type="file" multiple accept=".png,.jpg,.jpeg,.pdf,.mp4" hidden data-media-input />}
      <p class="form-status media-status" data-media-status aria-live="assertive"></p>
      {artifacts.length > 0 ? (
        <div class="artifact-carousel" data-artifact-carousel {...(publicOnlyBuild ? {} : { 'data-media-dropzone': true })} tabindex={artifacts.length > 1 ? '0' : undefined} aria-label="Project artifacts carousel">
          <div class="artifact-carousel__viewport" data-carousel-viewport>
            <div class="artifact-carousel__track" data-carousel-track>
              {artifacts.map((artifact, index) => (
                <figure class="artifact-slide" data-carousel-slide aria-hidden={index === 0 ? 'false' : 'true'}>
                  <a class="artifact-slide__media" href={artifact.href} target="_blank" rel="noreferrer" aria-label={`Open ${artifact.filename}`}>
                    {artifact.kind === 'image' ? (
                      <img src={artifact.href} alt={`Preview of ${artifact.filename}`} loading={index === 0 ? 'eager' : 'lazy'} />
                    ) : artifact.kind === 'video' ? (
                      <video src={artifact.href} muted playsinline preload="metadata"></video>
                    ) : (
                      <div class="artifact-slide__document" data-pdf-preview={artifact.kind === 'pdf' ? artifact.href : undefined}><span aria-hidden="true">▤</span><strong>{artifact.kind.toUpperCase()}</strong><small>Open to preview</small></div>
                    )}
                  </a>
                  <button type="button" class="artifact-slide__feature" data-media-feature-trigger data-filename={artifact.filename} data-featured={artifact.filename === heroArtifact?.filename ? 'true' : 'false'} aria-label={artifact.filename === heroArtifact?.filename ? `${artifact.filename} is the featured artifact` : `Feature ${artifact.filename}`} title="Featured artifact shows on the project card">
                    <svg viewBox="0 0 24 24" aria-hidden="true" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 2.6 2.9 5.9 6.5.9-4.7 4.6 1.1 6.5-5.8-3-5.8 3 1.1-6.5L2.6 9.4l6.5-.9z"></path></svg>
                  </button>
                  <button type="button" class="artifact-slide__delete" data-media-delete-trigger data-filename={artifact.filename} aria-label={`Delete ${artifact.filename}`} title={`Delete ${artifact.filename}`}>
                    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2"></path><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path><path d="M10 11v6"></path><path d="M14 11v6"></path></svg>
                  </button>
                  <figcaption>
                    <div><strong>{artifact.filename}</strong><span>{formatLabel(artifact.kind)}</span></div>
                    <a href={artifact.href} target="_blank" rel="noreferrer">Open original ↗</a>
                  </figcaption>
                </figure>
              ))}
            </div>
          </div>

          {privateProject && (
            <span class="artifact-privacy-lock artifact-privacy-lock--detail" aria-label="Private project">
              <svg aria-hidden="true" viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="11" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"></path></svg>
            </span>
          )}

          {artifacts.length > 1 && (
            <div class="artifact-carousel__footer">
              <p aria-live="polite"><strong data-carousel-current>1</strong> / {artifacts.length}</p>
              <div class="artifact-carousel__controls">
                <button type="button" data-carousel-previous aria-label="Show previous artifact"><span aria-hidden="true">←</span></button>
                <button type="button" data-carousel-next aria-label="Show next artifact"><span aria-hidden="true">→</span></button>
              </div>
            </div>
          )}

          <div class="artifact-carousel__thumbnails" data-media-tiles aria-label="Choose an artifact, or drag a tile to reorder">
            {artifacts.map((artifact, index) => (
              <button type="button" data-carousel-thumbnail {...(publicOnlyBuild ? {} : { 'data-media-tile': true })} data-filename={artifact.filename} data-active={index === 0 ? 'true' : 'false'} aria-label={`Show ${artifact.filename}`} aria-current={index === 0 ? 'true' : undefined}>
                {artifact.kind === 'image' ? <img src={artifact.href} alt="" loading="lazy" draggable="false" /> : <span data-pdf-preview={artifact.kind === 'pdf' ? artifact.href : undefined}>{artifact.kind.toUpperCase()}</span>}
              </button>
            ))}
          </div>

          {!publicOnlyBuild && (
          <div class="media-trash-row">
            <span class="media-trash" data-media-trash aria-label="Drag a media tile here to delete it">
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2"></path><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path><path d="M10 11v6"></path><path d="M14 11v6"></path></svg>
              <small>Drag a tile here to delete</small>
            </span>
          </div>
          )}
        </div>
      ) : publicOnlyBuild ? (
        <div class="artifact-empty">
          <span aria-hidden="true">□</span><div><h3>No artifacts attached yet</h3><p>Media for this project is added from the local workbench.</p></div>
        </div>
      ) : (
        <button type="button" class="artifact-empty artifact-empty--dropzone" data-media-dropzone data-media-browse>
          <span aria-hidden="true">⬇</span><div><h3>No artifacts attached yet</h3><p>Drop images, PDFs, or videos here — or click to browse your files.</p></div>
        </button>
      )}

      <dialog class="media-delete-dialog" data-media-delete-dialog>
        <h3>Delete this artifact?</h3>
        <p><strong data-media-delete-name></strong> will be removed from the project folder. This cannot be undone.</p>
        <div class="media-delete-dialog__actions">
          <button type="button" class="media-delete-dialog__cancel" data-media-delete-cancel>Cancel</button>
          <button type="button" class="media-delete-dialog__confirm" data-media-delete-confirm>Delete</button>
        </div>
      </dialog>
    </section>
    )}
  </div>
</BaseLayout>

<script>
  import {
    browserSupportsWebAuthn,
    startAuthentication,
    startRegistration,
  } from '@simplewebauthn/browser';

  type FormError = Error & { field?: string; authRequired?: boolean; authProvider?: string; status?: number };

  // Arriving with #edit (e.g. from a portfolio-index card) opens the editor directly.
  // Strip the hash afterwards so later reloads (media saves reload the page) don't
  // scroll back up to the editor again.
  if (window.location.hash === '#edit') {
    const editDetails = document.querySelector<HTMLDetailsElement>('[data-project-edit-details]');
    if (editDetails && editDetails.dataset.private !== 'true') {
      editDetails.open = true;
      editDetails.scrollIntoView({ block: 'start' });
    }
    window.history.replaceState(null, '', window.location.pathname);
  }

  // Media saves reload the page (astro re-syncs content); bring the reader back to the
  // tiles they were working with. An absolute scroll position won't do — lazy-loaded
  // images keep the page short at restore time, so the position would clamp.
  try {
    if (window.sessionStorage.getItem('media-op-return') !== null) {
      window.sessionStorage.removeItem('media-op-return');
      const returnToTiles = () =>
        document.querySelector('[data-media-tiles]')?.scrollIntoView({ block: 'center' });
      returnToTiles();
      window.addEventListener('load', () => requestAnimationFrame(returnToTiles), { once: true });
    }
  } catch { /* storage unavailable (private mode etc.) is fine */ }
  const rememberScroll = () => {
    try { window.sessionStorage.setItem('media-op-return', 'tiles'); } catch { /* ignore */ }
  };

  // Render the first page of each PDF artifact as its preview (carousel slide and
  // thumbnail tile). The generic "PDF / Open to preview" card stays as the fallback.
  void (async () => {
    const targets = [...document.querySelectorAll<HTMLElement>('[data-pdf-preview]')];
    if (!targets.length) return;
    try {
      const pdfjs = await import('pdfjs-dist');
      const worker = await import('pdfjs-dist/build/pdf.worker.min.mjs?url');
      pdfjs.GlobalWorkerOptions.workerSrc = worker.default;
      const rendered = new Map<string, string>();

      for (const target of targets) {
        const href = target.dataset.pdfPreview ?? '';
        try {
          let dataUrl = rendered.get(href);
          if (!dataUrl) {
            const doc = await pdfjs.getDocument({ url: new URL(href, window.location.origin).toString() }).promise;
            const page = await doc.getPage(1);
            const base = page.getViewport({ scale: 1 });
            // render wide enough for the big slide; tiles reuse the same bitmap
            const scale = Math.min(1200 / base.width, 4);
            const viewport = page.getViewport({ scale });
            const canvas = document.createElement('canvas');
            canvas.width = Math.ceil(viewport.width);
            canvas.height = Math.ceil(viewport.height);
            const context = canvas.getContext('2d');
            if (!context) continue;
            await page.render({ canvas, canvasContext: context, viewport }).promise;
            dataUrl = canvas.toDataURL('image/png');
            rendered.set(href, dataUrl);
          }
          const img = document.createElement('img');
          img.src = dataUrl;
          img.alt = 'First page of the PDF';
          img.draggable = false;
          target.replaceChildren(img);
          target.classList.add('pdf-preview--ready');
        } catch (error) {
          console.error('[pdf-preview] could not render', href, error);
        }
      }
    } catch (error) {
      console.error('[pdf-preview] pdf.js failed to load', error);
    }
  })();

  document.querySelectorAll<HTMLElement>('[data-artifact-carousel]').forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>('[data-carousel-track]');
    const slides = [...carousel.querySelectorAll<HTMLElement>('[data-carousel-slide]')];
    const thumbnails = [...carousel.querySelectorAll<HTMLButtonElement>('[data-carousel-thumbnail]')];
    const currentLabel = carousel.querySelector<HTMLElement>('[data-carousel-current]');
    let current = 0;
    let touchStartX = 0;

    const show = (next: number) => {
      if (!track || slides.length === 0) return;
      current = (next + slides.length) % slides.length;
      track.style.transform = `translateX(-${current * 100}%)`;
      slides.forEach((slide, index) => slide.setAttribute('aria-hidden', String(index !== current)));
      thumbnails.forEach((thumbnail, index) => {
        thumbnail.dataset.active = String(index === current);
        if (index === current) thumbnail.setAttribute('aria-current', 'true');
        else thumbnail.removeAttribute('aria-current');
      });
      if (currentLabel) currentLabel.textContent = String(current + 1);
    };

    carousel.querySelector<HTMLButtonElement>('[data-carousel-previous]')?.addEventListener('click', () => show(current - 1));
    carousel.querySelector<HTMLButtonElement>('[data-carousel-next]')?.addEventListener('click', () => show(current + 1));
    thumbnails.forEach((thumbnail, index) => thumbnail.addEventListener('click', () => show(index)));
    carousel.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') { event.preventDefault(); show(current - 1); }
      if (event.key === 'ArrowRight') { event.preventDefault(); show(current + 1); }
    });
    carousel.addEventListener('touchstart', (event) => { touchStartX = event.changedTouches[0]?.clientX ?? 0; }, { passive: true });
    carousel.addEventListener('touchend', (event) => {
      const distance = (event.changedTouches[0]?.clientX ?? touchStartX) - touchStartX;
      if (Math.abs(distance) > 45) show(current + (distance < 0 ? 1 : -1));
    }, { passive: true });
  });

  const setBusy = (form: HTMLFormElement, busy: boolean) => {
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (button) button.disabled = busy;
  };

  const clearFieldErrors = (form: HTMLFormElement) => {
    form.querySelectorAll<HTMLElement>('.field--invalid').forEach((field) => field.classList.remove('field--invalid'));
    form.querySelectorAll<HTMLElement>('[aria-invalid="true"]').forEach((control) => control.removeAttribute('aria-invalid'));
    form.querySelectorAll<HTMLElement>('[data-field-error]').forEach((message) => message.remove());
    form.querySelector<HTMLElement>('.form-status')?.classList.remove('form-status--error');
  };

  const showError = (form: HTMLFormElement, status: HTMLElement | null, message: string, fieldName?: string) => {
    clearFieldErrors(form);
    if (status) { status.classList.add('form-status--error'); status.textContent = message; }
    if (!fieldName) return;
    const control = form.elements.namedItem(fieldName);
    if (!(control instanceof HTMLElement)) return;
    const field = control.closest<HTMLElement>('.field');
    if (!field) return;
    field.classList.add('field--invalid');
    control.setAttribute('aria-invalid', 'true');
    const note = document.createElement('p');
    note.className = 'field-error';
    note.dataset.fieldError = '';
    note.textContent = message;
    field.append(note);
    control.focus();
  };

  const firstInvalid = (form: HTMLFormElement) => [...form.elements].find(
    (control): control is HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement =>
      (control instanceof HTMLInputElement || control instanceof HTMLSelectElement || control instanceof HTMLTextAreaElement) && !control.validity.valid,
  );

  let editUnlockToken = '';

  const postJson = async (url: string, payload: unknown) => {
    const headers: Record<string, string> = { 'Content-Type': 'application/json' };
    if (editUnlockToken) headers['X-Portfolio-Unlock'] = editUnlockToken;
    const response = await fetch(url, { method: 'POST', headers, body: JSON.stringify(payload) });
    const result = await response.json();
    if (!response.ok) {
      const error = Object.assign(new Error(result.error ?? 'The file could not be saved.'), result) as FormError;
      error.status = response.status;
      throw error;
    }
    return result;
  };

  const protectedControls = [...document.querySelectorAll<HTMLElement>('[data-protected-project-control="true"]')];
  const projectAuthStatus = document.querySelector<HTMLElement>('[data-project-auth-status]');
  let unlockBusy = false;

  const showProjectAuthStatus = (message: string, error = false) => {
    if (!projectAuthStatus) return;
    projectAuthStatus.hidden = false;
    projectAuthStatus.classList.toggle('project-editor__auth-status--error', error);
    projectAuthStatus.textContent = message;
  };

  protectedControls.forEach((control) => {
    control.addEventListener('click', async (event) => {
      if (editUnlockToken) return;
      event.preventDefault();
      if (unlockBusy) return;
      unlockBusy = true;
      const label = control.querySelector<HTMLElement>('[data-protected-label]');
      if (label) label.textContent = 'Waiting for device unlock…';
      showProjectAuthStatus('Use your device’s face, fingerprint, PIN, or password to continue.');

      try {
        if (!window.isSecureContext || !browserSupportsWebAuthn()) {
          throw new Error('Device unlock requires HTTPS (or localhost) and a browser that supports passkeys.');
        }
        const optionsResult = await postJson('/api/local/device-auth/options', {});
        const passkeyResponse = optionsResult.mode === 'registration'
          ? await startRegistration({ optionsJSON: optionsResult.options })
          : await startAuthentication({ optionsJSON: optionsResult.options });
        const verification = await postJson('/api/local/device-auth/verify', {
          ceremonyId: optionsResult.ceremonyId,
          mode: optionsResult.mode,
          response: passkeyResponse,
        });
        if (!verification.verified || !verification.token) throw new Error('The device could not verify your identity.');
        editUnlockToken = String(verification.token);
        protectedControls.forEach((item) => {
          const itemLabel = item.querySelector<HTMLElement>('[data-protected-label]');
          if (itemLabel) itemLabel.textContent = item.dataset.unlockedLabel ?? 'Edit project';
        });
        showProjectAuthStatus('Unlocked on this page for 10 minutes.');
        const details = control.closest<HTMLDetailsElement>('details');
        if (details) details.open = true;
      } catch (error) {
        if (label) label.textContent = control.dataset.unlockedLabel === 'Add artifact' ? 'Unlock to add artifact' : 'Unlock project editor';
        showProjectAuthStatus(error instanceof Error ? error.message : 'Device unlock was canceled or unavailable.', true);
      } finally {
        unlockBusy = false;
      }
    });
  });

  const editForm = document.querySelector<HTMLFormElement>('[data-project-edit-form]');
  const aiResult = document.querySelector<HTMLElement>('[data-edit-ai-result]');
  const repositoryUrl = document.querySelector<HTMLInputElement>('[data-edit-repository-url]');
  const repositoryButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-edit-repository-mode]')];
  const repositoryAuth = document.querySelector<HTMLElement>('[data-edit-repository-auth]');

  const applyDraft = (draft: Record<string, unknown>) => {
    if (!editForm) return 0;
    let changed = 0;
    for (const name of ['name', 'description', 'why', 'status', 'privacy', 'startDate'] as const) {
      const value = String(draft[name] ?? '');
      const control = editForm.elements.namedItem(name);
      if (!value || !(control instanceof HTMLInputElement || control instanceof HTMLTextAreaElement || control instanceof HTMLSelectElement)) continue;
      if (control instanceof HTMLSelectElement && ![...control.options].some((option) => option.value === value)) continue;
      control.value = value;
      changed += 1;
    }
    return changed;
  };

  const showAuthentication = (provider: 'github' | 'azure', retry: () => void) => {
    if (!repositoryAuth) return;
    repositoryAuth.hidden = false;
    repositoryAuth.replaceChildren();
    const message = document.createElement('p');
    message.textContent = `This private repository needs access through ${provider === 'azure' ? 'your Microsoft work account' : 'GitHub'}.`;
    const signIn = document.createElement('button');
    signIn.type = 'button';
    signIn.textContent = provider === 'azure' ? 'Sign in with Microsoft' : 'Sign in with GitHub';
    repositoryAuth.append(message, signIn);
    signIn.addEventListener('click', async () => {
      signIn.disabled = true;
      signIn.textContent = 'Starting secure sign-in…';
      try {
        const result = await postJson('/api/local/repository-auth', { provider, repositoryUrl: repositoryUrl?.value ?? '' });
        repositoryAuth.replaceChildren();
        const instructions = document.createElement('p');
        instructions.textContent = result.userCode ? 'Enter this one-time code in the sign-in page, approve access, then retry.' : 'Access is ready. Retry the repository analysis.';
        repositoryAuth.append(instructions);
        if (result.userCode) {
          const code = document.createElement('code'); code.textContent = String(result.userCode);
          const link = document.createElement('a'); link.href = String(result.verificationUrl ?? 'https://github.com/login/device'); link.target = '_blank'; link.rel = 'noreferrer'; link.textContent = 'Open sign-in ↗';
          repositoryAuth.append(code, link);
        }
        const retryButton = document.createElement('button'); retryButton.type = 'button'; retryButton.textContent = 'I approved it — retry'; retryButton.addEventListener('click', retry); repositoryAuth.append(retryButton);
      } catch (error) {
        repositoryAuth.classList.add('repository-auth--error');
        repositoryAuth.textContent = error instanceof Error ? error.message : 'Repository sign-in could not start.';
      }
    });
  };

  const analyzeRepository = async (mode: 'strict' | 'inferred') => {
    if (!editForm || !aiResult || !repositoryUrl) return;
    const address = repositoryUrl.value.trim();
    if (!address) { aiResult.className = 'ai-fill-result ai-fill-result--error'; aiResult.textContent = 'Enter the repository’s main address first.'; repositoryUrl.focus(); return; }
    const name = (editForm.elements.namedItem('name') as HTMLInputElement).value;
    const description = (editForm.elements.namedItem('description') as HTMLTextAreaElement).value;
    repositoryButtons.forEach((button) => (button.disabled = true));
    aiResult.className = 'ai-fill-result ai-fill-result--working';
    aiResult.textContent = 'Reading the commit history, inspecting the code, and drafting this edit…';
    try {
      const result = await postJson('/api/local/repository-fill', { mode, repositoryUrl: address, current: { name, description } });
      const changed = applyDraft(result.draft ?? {});
      aiResult.className = 'ai-fill-result ai-fill-result--success';
      aiResult.textContent = `${changed ? `Drafted ${changed} ${changed === 1 ? 'field' : 'fields'}` : 'No supported changes were found'} from the repository. Review, then save.`;
      if (repositoryAuth) repositoryAuth.hidden = true;
    } catch (error) {
      const problem = error as FormError;
      aiResult.className = 'ai-fill-result ai-fill-result--error';
      aiResult.textContent = problem.message || 'The repository could not be analyzed.';
      if (problem.authRequired) showAuthentication(problem.authProvider === 'azure' ? 'azure' : 'github', () => void analyzeRepository(mode));
    } finally {
      repositoryButtons.forEach((button) => (button.disabled = false));
    }
  };

  repositoryButtons.forEach((button) => button.addEventListener('click', () => {
    const mode = button.dataset.editRepositoryMode;
    if (mode === 'strict' || mode === 'inferred') void analyzeRepository(mode);
  }));

  editForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const status = editForm.querySelector<HTMLElement>('[data-project-edit-status]');
    clearFieldErrors(editForm);
    const invalid = firstInvalid(editForm);
    if (invalid) { showError(editForm, status, invalid.validationMessage || 'This field needs your attention.', invalid.name); return; }
    const formData = new FormData(editForm);
    setBusy(editForm, true);
    if (status) status.textContent = 'Saving the project changes…';
    try {
      await postJson(`/api/local/projects/${encodeURIComponent(editForm.dataset.projectSlug ?? '')}`, {
        name: String(formData.get('name') ?? ''), description: String(formData.get('description') ?? ''), why: String(formData.get('why') ?? ''), status: String(formData.get('status') ?? ''), privacy: String(formData.get('privacy') ?? ''), startDate: String(formData.get('startDate') ?? ''),
      });
      if (status) status.textContent = 'Saved. Refreshing the project…';
      window.setTimeout(() => window.location.reload(), 400);
    } catch (error) {
      const problem = error as FormError;
      if (problem.status === 401) editUnlockToken = '';
      showError(editForm, status, problem.message || 'The project could not be updated.', problem.field);
      setBusy(editForm, false);
    }
  });

  const mediaSection = document.querySelector<HTMLElement>('[data-media-section]');
  if (mediaSection) {
    const mediaSlug = encodeURIComponent(mediaSection.dataset.projectSlug ?? '');
    const mediaStatus = mediaSection.querySelector<HTMLElement>('[data-media-status]');
    const mediaInput = mediaSection.querySelector<HTMLInputElement>('[data-media-input]');
    const tilesRow = mediaSection.querySelector<HTMLElement>('[data-media-tiles]');
    const trash = mediaSection.querySelector<HTMLElement>('[data-media-trash]');
    const deleteDialog = mediaSection.querySelector<HTMLDialogElement>('[data-media-delete-dialog]');
    const deleteName = mediaSection.querySelector<HTMLElement>('[data-media-delete-name]');

    const setMediaStatus = (message: string, error = false) => {
      if (!mediaStatus) return;
      mediaStatus.textContent = message;
      mediaStatus.classList.toggle('media-status--error', error);
    };
    const mediaFailure = (error: unknown, fallback: string) => {
      const problem = error as FormError;
      if (problem.status === 401) editUnlockToken = '';
      setMediaStatus(problem.message || fallback, true);
    };

    // --- adding media: file picker + drop anywhere on the carousel ---
    const allowedMedia = /\.(png|jpe?g|pdf|mp4)$/i;
    let uploading = false;
    const uploadMediaFiles = async (incoming: FileList | File[]) => {
      if (uploading) return;
      const files = [...incoming];
      const rejected = files.filter((file) => !allowedMedia.test(file.name) || file.size > 25 * 1024 * 1024);
      const accepted = files.filter((file) => !rejected.includes(file));
      if (!accepted.length) {
        setMediaStatus('Media must be PNG, JPG, PDF, or MP4 files up to 25 MB.', true);
        return;
      }
      uploading = true;
      try {
        for (const [index, file] of accepted.entries()) {
          setMediaStatus(`Adding ${file.name} (${index + 1} of ${accepted.length})…`);
          const dataUrl = await new Promise<string>((resolve, reject) => {
            const reader = new FileReader();
            reader.addEventListener('load', () => resolve(String(reader.result)));
            reader.addEventListener('error', () => reject(new Error(`${file.name} could not be read.`)));
            reader.readAsDataURL(file);
          });
          await postJson(`/api/local/projects/${mediaSlug}/artifacts`, { filename: file.name, data: dataUrl.slice(dataUrl.indexOf(',') + 1) });
        }
        rememberScroll();
        setMediaStatus(rejected.length ? `Added ${accepted.length}, skipped ${rejected.length} unsupported file(s). Refreshing…` : 'Added. Refreshing the artifacts…');
        // index.md changed, so astro dev reloads the page itself once content re-syncs;
        // this slower manual reload is only a fallback (racing it renders stale data)
        window.setTimeout(() => window.location.reload(), 2000);
      } catch (error) {
        uploading = false;
        mediaFailure(error, 'The media could not be added.');
      }
    };

    mediaSection.querySelectorAll<HTMLElement>('[data-media-browse]').forEach((trigger) => {
      trigger.addEventListener('click', () => mediaInput?.click());
    });
    mediaInput?.addEventListener('change', () => {
      if (mediaInput.files?.length) void uploadMediaFiles(mediaInput.files);
      mediaInput.value = '';
    });

    const isFileDrag = (event: DragEvent) => [...(event.dataTransfer?.types ?? [])].includes('Files');
    mediaSection.querySelectorAll<HTMLElement>('[data-media-dropzone]').forEach((zone) => {
      zone.addEventListener('dragover', (event) => {
        if (!isFileDrag(event)) return;
        event.preventDefault();
        zone.classList.add('media-dropzone--over');
      });
      zone.addEventListener('dragleave', () => zone.classList.remove('media-dropzone--over'));
      zone.addEventListener('drop', (event) => {
        if (!isFileDrag(event)) return;
        event.preventDefault();
        zone.classList.remove('media-dropzone--over');
        if (event.dataTransfer?.files.length) void uploadMediaFiles(event.dataTransfer.files);
      });
    });

    // --- reordering & deleting: pointer-based tile drag (works for mouse AND touch;
    // HTML5 drag events never fire on touch input). Mouse lifts a tile after a few
    // pixels of movement; touch lifts after a short hold so taps still select slides.
    let draggedTile: HTMLElement | null = null;
    let tileSnapshot: HTMLElement[] = [];
    let pendingDelete = '';
    let dragJustEnded = false;
    let pendingDrag: { tile: HTMLElement; x: number; y: number; timer: number } | null = null;

    const openDeleteDialog = (filename: string) => {
      pendingDelete = filename;
      if (!pendingDelete || !deleteDialog) return;
      if (deleteName) deleteName.textContent = pendingDelete;
      deleteDialog.showModal();
    };

    mediaSection.querySelectorAll<HTMLButtonElement>('[data-media-delete-trigger]').forEach((trigger) => {
      trigger.addEventListener('click', () => openDeleteDialog(trigger.dataset.filename ?? ''));
    });

    // starring an artifact makes it the project's featured artifact (the card hero)
    mediaSection.querySelectorAll<HTMLButtonElement>('[data-media-feature-trigger]').forEach((trigger) => {
      trigger.addEventListener('click', async () => {
        const filename = trigger.dataset.filename ?? '';
        if (!filename || trigger.dataset.featured === 'true') return;
        setMediaStatus(`Featuring ${filename}…`);
        try {
          await postJson(`/api/local/projects/${mediaSlug}/artifacts/feature`, { filename });
          mediaSection.querySelectorAll<HTMLButtonElement>('[data-media-feature-trigger]').forEach((star) => {
            star.dataset.featured = String(star === trigger);
          });
          rememberScroll();
          setMediaStatus(`${filename} is now featured. Refreshing…`);
          window.setTimeout(() => window.location.reload(), 2000);
        } catch (error) {
          mediaFailure(error, 'The artifact could not be featured.');
        }
      });
    });

    const tileOrder = () =>
      [...(tilesRow?.querySelectorAll<HTMLElement>('[data-media-tile]') ?? [])].map((tile) => tile.dataset.filename ?? '');
    const restoreTileOrder = () => tileSnapshot.forEach((tile) => tilesRow?.appendChild(tile));

    // NOTE: no setPointerCapture here — moving the dragged tile with insertBefore
    // removes+reinserts it, which silently releases pointer capture. Window-level
    // listeners during the drag keep working no matter where the pointer goes.
    const onDragMove = (event: PointerEvent) => {
      if (!draggedTile || !tilesRow) return;
      event.preventDefault();
      const under = document.elementFromPoint(event.clientX, event.clientY);
      const overTrash = Boolean(under?.closest('[data-media-trash]'));
      trash?.classList.toggle('media-trash--target', overTrash);
      if (overTrash) return;
      const over = under?.closest<HTMLElement>('[data-media-tile]');
      if (!over || over === draggedTile) return;
      const rect = over.getBoundingClientRect();
      tilesRow.insertBefore(draggedTile, event.clientX < rect.left + rect.width / 2 ? over : over.nextSibling);
    };
    const onDragUp = (event: PointerEvent) => void endTileDrag(event, false);
    const onDragCancel = (event: PointerEvent) => void endTileDrag(event, true);

    const beginTileDrag = (tile: HTMLElement) => {
      draggedTile = tile;
      tileSnapshot = [...(tilesRow?.querySelectorAll<HTMLElement>('[data-media-tile]') ?? [])];
      tile.classList.add('media-tile--dragging');
      trash?.classList.add('media-trash--armed');
      window.addEventListener('pointermove', onDragMove);
      window.addEventListener('pointerup', onDragUp);
      window.addEventListener('pointercancel', onDragCancel);
    };

    tilesRow?.addEventListener('pointerdown', (event) => {
      if (!event.isPrimary || (event.pointerType === 'mouse' && event.button !== 0)) return;
      const tile = (event.target as HTMLElement).closest<HTMLElement>('[data-media-tile]');
      if (!tile) return;
      pendingDrag = {
        tile,
        x: event.clientX,
        y: event.clientY,
        // touch: hold ~300ms to lift; mouse: 0 means "lift on movement instead"
        timer: event.pointerType === 'mouse'
          ? 0
          : window.setTimeout(() => { if (pendingDrag?.tile === tile) beginTileDrag(tile); }, 300),
      };
    });

    tilesRow?.addEventListener('pointermove', (event) => {
      if (!pendingDrag || draggedTile) return;
      const moved = Math.hypot(event.clientX - pendingDrag.x, event.clientY - pendingDrag.y);
      if (pendingDrag.timer) {
        // touch that moves before the hold completes is a tap/scroll, not a drag
        if (moved > 10) { clearTimeout(pendingDrag.timer); pendingDrag = null; }
        return;
      }
      if (moved > 6) {
        beginTileDrag(pendingDrag.tile);
        onDragMove(event);
      }
    });
    tilesRow?.addEventListener('pointerup', () => {
      if (pendingDrag?.timer) clearTimeout(pendingDrag.timer);
      if (!draggedTile) pendingDrag = null;
    });

    const endTileDrag = async (event: PointerEvent, cancelled: boolean) => {
      window.removeEventListener('pointermove', onDragMove);
      window.removeEventListener('pointerup', onDragUp);
      window.removeEventListener('pointercancel', onDragCancel);
      if (pendingDrag?.timer) clearTimeout(pendingDrag.timer);
      pendingDrag = null;
      if (!draggedTile) return;
      const tile = draggedTile;
      draggedTile = null;
      dragJustEnded = true;
      window.setTimeout(() => { dragJustEnded = false; }, 0);
      tile.classList.remove('media-tile--dragging');
      trash?.classList.remove('media-trash--armed', 'media-trash--target');

      if (cancelled) { restoreTileOrder(); return; }

      const under = document.elementFromPoint(event.clientX, event.clientY);
      if (under?.closest('[data-media-trash]')) {
        restoreTileOrder();
        openDeleteDialog(tile.dataset.filename ?? '');
        return;
      }

      const order = tileOrder();
      if (JSON.stringify(order) === JSON.stringify(tileSnapshot.map((snap) => snap.dataset.filename ?? ''))) return;
      setMediaStatus('Saving the new order…');
      try {
        await postJson(`/api/local/projects/${mediaSlug}/artifacts/order`, { order });
        rememberScroll();
        setMediaStatus('Order saved. Refreshing…');
        window.setTimeout(() => window.location.reload(), 2000);
      } catch (error) {
        restoreTileOrder();
        mediaFailure(error, 'The order could not be saved.');
      }
    };
    // a completed drag must not also fire the thumbnail's slide-select click,
    // and a touch hold must not open the context menu mid-drag
    tilesRow?.addEventListener('click', (event) => {
      if (dragJustEnded) { event.preventDefault(); event.stopPropagation(); }
    }, true);
    tilesRow?.addEventListener('contextmenu', (event) => {
      if (draggedTile || pendingDrag) event.preventDefault();
    });

    deleteDialog?.querySelector('[data-media-delete-cancel]')?.addEventListener('click', () => deleteDialog.close());
    deleteDialog?.querySelector<HTMLButtonElement>('[data-media-delete-confirm]')?.addEventListener('click', async (event) => {
      const confirmButton = event.currentTarget as HTMLButtonElement;
      confirmButton.disabled = true;
      setMediaStatus(`Deleting ${pendingDelete}…`);
      try {
        await postJson(`/api/local/projects/${mediaSlug}/artifacts/delete`, { filename: pendingDelete });
        deleteDialog.close();
        rememberScroll();
        setMediaStatus('Deleted. Refreshing the artifacts…');
        window.setTimeout(() => window.location.reload(), 2000);
      } catch (error) {
        deleteDialog.close();
        mediaFailure(error, 'The media could not be deleted.');
      } finally {
        confirmButton.disabled = false;
      }
    });
  }

</script>
