---
import { getCollection } from 'astro:content';
import ProjectCard from '../components/ProjectCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
const projects = (await getCollection('projects'))
  .filter((project) => !project.data.deleted)
  .sort((a, b) => b.data.updatedDate.getTime() - a.data.updatedDate.getTime());
---

<BaseLayout>
  <div class="page-shell home-page">
    <section class="work-section" aria-labelledby="work-heading">
      <div class="section-heading section-heading--carousel">
        <div><p class="eyebrow">Portfolio index</p><h2 id="work-heading">The project reel.</h2></div>
      </div>
      <div class="project-coverflow" data-project-coverflow tabindex="0" aria-label="Project carousel. Use the arrow keys or controls to browse projects.">
        <div class="project-coverflow__stage" data-project-grid>{projects.map((project) => <ProjectCard project={project} />)}</div>
        <div class="project-coverflow__navigation">
          <button type="button" data-project-coverflow-previous aria-label="Show previous project"><span aria-hidden="true">←</span></button>
          <div class="project-coverflow__position" aria-live="polite"><strong data-project-coverflow-current>1</strong><span>/</span><span data-project-coverflow-total>{projects.length}</span></div>
          <div class="project-coverflow__dots" aria-label="Choose a project">
            {projects.map((project, index) => (
              <button type="button" data-project-coverflow-dot data-project-id={project.data.id} data-active={index === 0 ? 'true' : 'false'} aria-label={`Show ${project.data.name}`} aria-current={index === 0 ? 'true' : undefined}></button>
            ))}
          </div>
          <button type="button" data-project-coverflow-next aria-label="Show next project"><span aria-hidden="true">→</span></button>
        </div>
      </div>

      <div class="filter-panel" aria-label="Filter projects">
        <div class="filter-panel__primary">
          <label class="search-field">
            <span>Search</span>
            <div><svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path d="m21 21-4.35-4.35m2.35-5.15a7.5 7.5 0 1 1-15 0 7.5 7.5 0 0 1 15 0Z" /></svg><input data-filter-search type="search" placeholder="Name, description, or why…" autocomplete="off" /></div>
          </label>
        </div>
        <button class="reset-filters" type="button" data-reset-filters hidden>Clear filters</button>
      </div>

      <aside class="private-unlock-panel" data-private-unlock-panel hidden aria-labelledby="private-unlock-title">
        <span class="private-unlock-panel__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="11" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"></path></svg>
        </span>
        <div>
          <h3 id="private-unlock-title">Private project</h3>
          <p>Use this laptop’s Windows Hello method to open it.</p>
          <p class="private-unlock-panel__status" data-private-unlock-status aria-live="assertive"></p>
        </div>
        <button class="primary-button" type="button" data-private-unlock-button>Unlock with Windows Hello</button>
      </aside>

      <div class="empty-results" data-empty-results hidden><span aria-hidden="true">⌁</span><h3>No matching projects</h3><p>Try a broader search or clear one of the filters.</p><button type="button" data-empty-reset>Clear all filters</button></div>
    </section>
  </div>
</BaseLayout>

<script>
  import {
    browserSupportsWebAuthn,
    startAuthentication,
    startRegistration,
  } from '@simplewebauthn/browser';

  const searchInput = document.querySelector<HTMLInputElement>('[data-filter-search]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-project-card]')];
  const emptyState = document.querySelector<HTMLElement>('[data-empty-results]');
  const resetButton = document.querySelector<HTMLButtonElement>('[data-reset-filters]');
  const emptyReset = document.querySelector<HTMLButtonElement>('[data-empty-reset]');
  const projectGrid = document.querySelector<HTMLElement>('[data-project-grid]');
  const unlockPanel = document.querySelector<HTMLElement>('[data-private-unlock-panel]');
  const unlockButton = document.querySelector<HTMLButtonElement>('[data-private-unlock-button]');
  const unlockStatus = document.querySelector<HTMLElement>('[data-private-unlock-status]');
  let pendingPrivateUrl = '';
  let unlockInProgress = false;
  const projectCoverflow = document.querySelector<HTMLElement>('[data-project-coverflow]');
  const coverflowCurrent = document.querySelector<HTMLElement>('[data-project-coverflow-current]');
  const coverflowTotal = document.querySelector<HTMLElement>('[data-project-coverflow-total]');
  const coverflowDots = [...document.querySelectorAll<HTMLButtonElement>('[data-project-coverflow-dot]')];
  let activeCoverflowCard: HTMLElement | null = cards[0] ?? null;

  const visibleCoverflowCards = () => projectGrid
    ? [...projectGrid.querySelectorAll<HTMLElement>('[data-project-card]')].filter((card) => !card.hidden)
    : [];

  function showCoverflowCard(next: number | HTMLElement) {
    const visibleCards = visibleCoverflowCards();
    if (!visibleCards.length) {
      if (projectCoverflow) projectCoverflow.hidden = true;
      return;
    }
    if (projectCoverflow) projectCoverflow.hidden = false;
    const requested = typeof next === 'number'
      ? visibleCards[(next + visibleCards.length) % visibleCards.length]
      : next;
    activeCoverflowCard = visibleCards.includes(requested) ? requested : visibleCards[0];
    const currentIndex = Math.max(0, visibleCards.indexOf(activeCoverflowCard));

    cards.forEach((card) => {
      let position = 'hidden';
      if (!card.hidden) {
        const index = visibleCards.indexOf(card);
        const previousIndex = (currentIndex - 1 + visibleCards.length) % visibleCards.length;
        const nextIndex = (currentIndex + 1) % visibleCards.length;
        position = index === currentIndex ? 'active' : index === previousIndex ? 'previous' : index === nextIndex ? 'next' : 'hidden';
        if (visibleCards.length === 2 && index !== currentIndex) position = 'next';
      }
      card.dataset.coverflowPosition = position;
      card.setAttribute('aria-hidden', String(position !== 'active'));
      card.inert = position !== 'active';
    });

    if (coverflowCurrent) coverflowCurrent.textContent = String(currentIndex + 1).padStart(2, '0');
    if (coverflowTotal) coverflowTotal.textContent = String(visibleCards.length).padStart(2, '0');
    coverflowDots.forEach((dot) => {
      const card = cards.find((candidate) => candidate.dataset.projectId === dot.dataset.projectId);
      dot.hidden = !card || card.hidden;
      const active = card === activeCoverflowCard;
      dot.dataset.active = String(active);
      if (active) dot.setAttribute('aria-current', 'true');
      else dot.removeAttribute('aria-current');
    });
  }

  function moveCoverflow(direction: number) {
    const visibleCards = visibleCoverflowCards();
    if (!visibleCards.length) return;
    const currentIndex = Math.max(0, visibleCards.indexOf(activeCoverflowCard ?? visibleCards[0]));
    showCoverflowCard(currentIndex + direction);
  }

  projectCoverflow?.querySelector('[data-project-coverflow-previous]')?.addEventListener('click', () => moveCoverflow(-1));
  projectCoverflow?.querySelector('[data-project-coverflow-next]')?.addEventListener('click', () => moveCoverflow(1));
  projectCoverflow?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft') { event.preventDefault(); moveCoverflow(-1); }
    if (event.key === 'ArrowRight') { event.preventDefault(); moveCoverflow(1); }
  });
  // swipe left/right on touch devices; vertical scrolling stays untouched
  let coverflowTouchX = 0;
  let coverflowTouchY = 0;
  projectCoverflow?.addEventListener('touchstart', (event) => {
    coverflowTouchX = event.changedTouches[0]?.clientX ?? 0;
    coverflowTouchY = event.changedTouches[0]?.clientY ?? 0;
  }, { passive: true });
  projectCoverflow?.addEventListener('touchend', (event) => {
    const deltaX = (event.changedTouches[0]?.clientX ?? coverflowTouchX) - coverflowTouchX;
    const deltaY = (event.changedTouches[0]?.clientY ?? coverflowTouchY) - coverflowTouchY;
    if (Math.abs(deltaX) > 44 && Math.abs(deltaX) > Math.abs(deltaY) * 1.5) {
      moveCoverflow(deltaX < 0 ? 1 : -1);
    }
  }, { passive: true });
  coverflowDots.forEach((dot) => dot.addEventListener('click', () => {
    const card = cards.find((candidate) => candidate.dataset.projectId === dot.dataset.projectId);
    if (card) showCoverflowCard(card);
  }));

  async function postAuth(path: string, body: unknown) {
    const response = await fetch(path, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });
    const result = await response.json().catch(() => ({})) as Record<string, any>;
    if (!response.ok) throw new Error(typeof result.error === 'string' ? result.error : 'Device unlock failed.');
    return result;
  }

  function showUnlockPanel(targetUrl: string) {
    pendingPrivateUrl = targetUrl;
    if (unlockPanel) unlockPanel.hidden = false;
    unlockPanel?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  async function unlockPrivateProject(targetUrl: string) {
    if (unlockInProgress) return;
    showUnlockPanel(targetUrl);
    if (unlockStatus) unlockStatus.textContent = '';
    unlockInProgress = true;
    if (unlockButton) unlockButton.disabled = true;
    try {
      const status = await fetch('/api/local/device-auth/status', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: '{}',
      });
      if (status.ok) {
        window.location.assign(targetUrl);
        return;
      }
      if (!browserSupportsWebAuthn()) throw new Error('Windows Hello is not available in this browser.');
      if (unlockStatus) unlockStatus.textContent = 'Waiting for Windows Hello…';
      const challenge = await postAuth('/api/local/device-auth/options', {});
      const credential = challenge.mode === 'registration'
        ? await startRegistration({ optionsJSON: challenge.options })
        : await startAuthentication({ optionsJSON: challenge.options });
      await postAuth('/api/local/device-auth/verify', {
        ceremonyId: challenge.ceremonyId,
        mode: challenge.mode,
        response: credential,
      });
      if (unlockStatus) unlockStatus.textContent = 'Unlocked. Opening project…';
      window.location.assign(targetUrl);
    } catch (error) {
      const cancelled = error instanceof DOMException && error.name === 'NotAllowedError';
      if (unlockStatus) unlockStatus.textContent = cancelled
        ? 'Windows Hello was cancelled. Select unlock to try again.'
        : error instanceof Error ? error.message : 'Device unlock failed.';
    } finally {
      unlockInProgress = false;
      if (unlockButton) unlockButton.disabled = false;
    }
  }

  document.querySelectorAll<HTMLAnchorElement>('[data-private-project-link]').forEach((link) => {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      void unlockPrivateProject(link.href);
    });
  });
  unlockButton?.addEventListener('click', () => {
    if (pendingPrivateUrl) void unlockPrivateProject(pendingPrivateUrl);
  });

  const requestedPrivateSlug = new URLSearchParams(window.location.search).get('unlock');
  if (requestedPrivateSlug && /^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(requestedPrivateSlug)) {
    showUnlockPanel(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/projects/${requestedPrivateSlug}`);
    if (unlockStatus) unlockStatus.textContent = 'This project is locked. Select unlock to continue.';
  }

  function applyFilters() {
    const query = searchInput?.value.trim().toLowerCase() ?? '';
    let visible = 0;
    cards.forEach((card) => {
      const matches = !query || (card.dataset.search ?? '').includes(query);
      card.hidden = !matches;
      if (matches) visible += 1;
    });
    if (emptyState) emptyState.hidden = visible !== 0;
    if (resetButton) resetButton.hidden = !query;
    showCoverflowCard(activeCoverflowCard ?? 0);
  }

  function resetFilters() {
    if (searchInput) searchInput.value = '';
    applyFilters();
    searchInput?.focus();
  }

  searchInput?.addEventListener('input', applyFilters);
  resetButton?.addEventListener('click', resetFilters);
  emptyReset?.addEventListener('click', resetFilters);
  showCoverflowCard(0);
</script>
