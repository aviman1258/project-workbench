---
import BaseLayout from '../layouts/BaseLayout.astro';
import RemoteCreate from '../components/RemoteCreate.astro';
import { privacyLevels, projectStatuses } from '../lib/project-schema';
import { formatLabel, publicOnlyBuild, withBase } from '../lib/projects';

const today = new Date().toISOString().slice(0, 10);
---

<BaseLayout title="Add a project" description="Create a new local portfolio project from the browser.">
  <div class="page-shell editor-page">
    <a class="back-link" href={withBase('/')}>← Portfolio index</a>

    {publicOnlyBuild && <RemoteCreate />}

    {!publicOnlyBuild && (
    <header class="editor-hero">
      <div>
        <p class="eyebrow">Local editor</p>
        <h1>Add a project.</h1>
        <p>Capture what it is, why you built it, and where it stands.</p>
      </div>
      <aside class="editor-note">
        <span aria-hidden="true">●</span>
        <p><strong>Writes to your project folder</strong><br />Available while <code>npm run dev</code> is running. Creating asks for your device unlock.</p>
      </aside>
    </header>
    )}

    {!publicOnlyBuild && (
    <form class="editor-form" data-project-form novalidate>
      <section class="editor-form__section">
        <div class="editor-form__heading">
          <span>01</span>
          <div><h2>Project</h2><p>The small set of details worth keeping.</p></div>
        </div>

        <label class="field">
          <span>Name</span>
          <input name="name" required maxlength="120" placeholder="A useful name for the project" autofocus />
        </label>
        <label class="field">
          <span>Description</span>
          <textarea name="description" required maxlength="500" rows="3" placeholder="What does it do?"></textarea>
        </label>
        <label class="field">
          <span>Why it was built</span>
          <textarea name="why" required maxlength="3000" rows="6" placeholder="What problem, curiosity, or need made you build it?"></textarea>
        </label>
      </section>

      <section class="editor-form__section">
        <div class="editor-form__heading">
          <span>02</span>
          <div><h2>State</h2><p>Just enough context to understand where the project stands.</p></div>
        </div>
        <div class="form-grid form-grid--three classification-grid">
          <label class="field">
            <span>Status</span>
            <select name="status" required>
              <option value="">Choose status</option>
              {projectStatuses.map((value) => <option value={value}>{formatLabel(value)}</option>)}
            </select>
          </label>
          <label class="field">
            <span>Privacy</span>
            <select name="privacy" required>
              <option value="">Choose privacy</option>
              {privacyLevels.map((value) => <option value={value}>{formatLabel(value)}</option>)}
            </select>
          </label>
          <label class="field">
            <span>Start date</span>
            <input name="startDate" type="date" value={today} required />
          </label>
        </div>
        <input name="updatedDate" type="hidden" value={today} />
      </section>

      <div class="editor-form__actions">
        <p class="form-status" data-form-status aria-live="assertive"></p>
        <button class="primary-button" type="submit">Create project →</button>
      </div>
    </form>
    )}
  </div>
</BaseLayout>

<script>
  import { deviceUnlock } from '../lib/device-unlock-client';

  type RepositoryError = Error & { field?: string };

  let unlockToken = '';

  // Creating a project requires the same device unlock as the rest of the editor.
  const ensureDeviceUnlock = async () => {
    if (unlockToken) return;
    unlockToken = await deviceUnlock();
  };

  const form = document.querySelector<HTMLFormElement>('[data-project-form]');
  const statusMessage = document.querySelector<HTMLElement>('[data-form-status]');

  const clearFormError = () => {
    form?.querySelectorAll<HTMLElement>('.field--invalid').forEach((field) => field.classList.remove('field--invalid'));
    form?.querySelectorAll<HTMLElement>('[aria-invalid="true"]').forEach((control) => control.removeAttribute('aria-invalid'));
    form?.querySelectorAll<HTMLElement>('[data-field-error]').forEach((message) => message.remove());
    statusMessage?.classList.remove('form-status--error');
    if (statusMessage) statusMessage.textContent = '';
  };

  const clearFieldError = (name: string) => {
    if (!form || !name) return;
    const control = form.elements.namedItem(name);
    if (!(control instanceof HTMLElement)) return;
    const field = control.closest<HTMLElement>('.field');
    field?.classList.remove('field--invalid');
    control.removeAttribute('aria-invalid');
    field?.querySelector<HTMLElement>('[data-field-error]')?.remove();
  };

  const showFormError = (message: string, fieldName?: string) => {
    clearFormError();
    if (statusMessage) {
      statusMessage.classList.add('form-status--error');
      statusMessage.textContent = `Couldn’t create the project: ${message}`;
    }
    if (!form || !fieldName) return;
    const control = form.elements.namedItem(fieldName);
    if (!(control instanceof HTMLElement)) return;
    const field = control.closest<HTMLElement>('.field');
    if (!field) return;
    field.classList.add('field--invalid');
    control.setAttribute('aria-invalid', 'true');
    const detail = document.createElement('p');
    detail.className = 'field-error';
    detail.dataset.fieldError = '';
    detail.textContent = message;
    field.append(detail);
    control.scrollIntoView({ behavior: 'smooth', block: 'center' });
    window.setTimeout(() => control.focus(), 250);
  };

  form?.addEventListener('input', (event) => clearFieldError((event.target as HTMLInputElement).name));
  form?.addEventListener('change', (event) => clearFieldError((event.target as HTMLInputElement).name));

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    clearFormError();
    const invalid = [...form.elements].find((control) =>
      control instanceof HTMLInputElement || control instanceof HTMLTextAreaElement || control instanceof HTMLSelectElement
        ? !control.validity.valid
        : false,
    ) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | undefined;
    if (invalid) {
      showFormError(invalid.validationMessage || 'This field needs your attention.', invalid.name);
      return;
    }

    const formData = new FormData(form);
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submit) submit.disabled = true;
    try {
      if (statusMessage) statusMessage.textContent = 'Confirm with Windows Hello to create the project…';
      await ensureDeviceUnlock();
      if (statusMessage) statusMessage.textContent = 'Creating the project…';
      const headers: Record<string, string> = { 'Content-Type': 'application/json' };
      if (unlockToken) headers['X-Portfolio-Unlock'] = unlockToken;
      const response = await fetch('/api/local/projects', {
        method: 'POST',
        headers,
        body: JSON.stringify({
          name: String(formData.get('name') ?? ''),
          description: String(formData.get('description') ?? ''),
          why: String(formData.get('why') ?? ''),
          status: String(formData.get('status') ?? ''),
          privacy: String(formData.get('privacy') ?? ''),
          startDate: String(formData.get('startDate') ?? ''),
          updatedDate: String(formData.get('updatedDate') ?? ''),
        }),
      });
      const result = await response.json();
      if (!response.ok) {
        if (response.status === 401) unlockToken = '';
        const error = new Error(result.error ?? 'The project could not be created.') as RepositoryError;
        error.field = result.field;
        throw error;
      }
      if (statusMessage) statusMessage.textContent = 'Created. Opening the project…';
      window.location.href = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/projects/${result.slug}/`;
    } catch (error) {
      const problem = error as RepositoryError;
      showFormError(problem.message || 'The project could not be created.', problem.field);
      if (submit) submit.disabled = false;
    }
  });
</script>
