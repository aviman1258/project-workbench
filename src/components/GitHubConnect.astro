---
// Shared "Connect GitHub" panel used by the hosted editor and hosted create form.
// The parent component's script wires it via wireTokenPanel() in lib/github-client.
---

<details class="remote-token-panel" data-remote-token-panel>
  <summary><span aria-hidden="true">◆</span><span data-remote-token-label>Connect GitHub to edit</span></summary>
  <div class="compact-form">
    <p class="remote-editor-hint">
      Paste a fine-grained personal access token with <strong>Contents: read and write</strong> on
      <code>aviman1258/project-workbench</code>. It is stored only in this browser.
      <a href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noreferrer">Create one on GitHub ↗</a>
    </p>
    <label class="field"><span>Access token</span><input type="password" data-remote-token-input autocomplete="off" placeholder="github_pat_…" /></label>
    <div class="compact-form__actions">
      <p class="form-status" data-remote-token-status aria-live="assertive"></p>
      <button class="primary-button" type="button" data-remote-token-save>Connect</button>
      <button class="remote-forget-button" type="button" data-remote-token-forget hidden>Forget token</button>
    </div>
  </div>
</details>
