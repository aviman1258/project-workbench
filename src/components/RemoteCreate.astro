---
import { projectStatuses } from '../lib/project-schema';
import { formatLabel, withBase } from '../lib/projects';

// Hosted-site "Add project": creates the project folder in the GitHub repo.
// Hosted creations are always public — private projects are made in the local workbench.
const today = new Date().toISOString().slice(0, 10);
---

<section class="project-editor" aria-labelledby="remote-create-title">
  <div class="project-editor__intro">
    <div><p class="eyebrow">On-the-go editor</p><h2 id="remote-create-title">Add a project</h2></div>
    <p>The project is committed to the GitHub repository; the site rebuilds itself in about a minute. Hosted projects are always public — private ones are created in the local workbench.</p>
  </div>

  <div class="project-editor__tools" data-remote-create data-projects-base={withBase('/projects')}>
    <p class="remote-editor-hint" data-remote-create-connect-hint>
      Connect GitHub with the connections icon in the header to add a project.
    </p>

    <details data-remote-create-panel hidden open>
      <summary><span aria-hidden="true">＋</span><span>New project</span></summary>
      <form class="compact-form" data-remote-create-form novalidate>
        <label class="field"><span>Name</span><input name="name" required maxlength="120" placeholder="A useful name for the project" /></label>
        <label class="field"><span>Description</span><textarea name="description" required maxlength="500" rows="3" placeholder="What does it do?"></textarea></label>
        <label class="field"><span>Why it was built</span><textarea name="why" required maxlength="3000" rows="6" placeholder="What problem, curiosity, or need made you build it?"></textarea></label>
        <label class="field"><span>Repository link</span><input name="repositoryUrl" type="url" data-create-repo maxlength="500" placeholder="https://github.com/owner/repository" /><small>Without a repository, the project stays an Idea. If it's a feature inside a larger repo, add the pull request link too.</small></label>
        <label class="field"><span>Pull request link (optional)</span><input name="pullRequestUrl" type="url" maxlength="500" placeholder="https://github.com/owner/repository/pull/123" /></label>
        <div class="create-ai">
          <button type="button" class="media-add-button" data-create-ai>✦ Draft from repository</button>
          <p class="form-status" data-create-ai-status aria-live="polite">Add the repository (or PR) link above, then let the AI draft the description and why.</p>
        </div>
        <div class="form-grid form-grid--two">
          <label class="field"><span>Status</span><select name="status" required>{projectStatuses.map((value) => <option value={value}>{formatLabel(value)}</option>)}</select></label>
          <label class="field"><span>Start date</span><input name="startDate" type="date" value={today} required /></label>
        </div>
        <div class="compact-form__actions">
          <p class="form-status" data-remote-create-status aria-live="assertive"></p>
          <button class="primary-button" type="submit">Create project →</button>
        </div>
      </form>
    </details>
  </div>
</section>

<script>
  import { stringify } from 'yaml';
  import { clearToken, encodeText, getStoredToken, listProjectFolders, putFile, TOKEN_EVENT } from '../lib/github-client';
  import { aiComplete, describeLastEvidence, gatherRepoContext } from '../lib/ai-complete';

  const root = document.querySelector<HTMLElement>('[data-remote-create]');
  if (root) {
    const projectsBase = root.dataset.projectsBase ?? '/projects';
    const panel = root.querySelector<HTMLDetailsElement>('[data-remote-create-panel]')!;
    const connectHint = root.querySelector<HTMLElement>('[data-remote-create-connect-hint]')!;

    // Connection lives in the header GitHub icon; this form just follows it.
    let token = '';
    const sync = () => {
      token = getStoredToken();
      panel.hidden = !token;
      connectHint.hidden = Boolean(token);
    };
    sync();
    window.addEventListener(TOKEN_EVENT, sync);

    const form = root.querySelector<HTMLFormElement>('[data-remote-create-form]')!;
    const status = root.querySelector<HTMLElement>('[data-remote-create-status]')!;

    // --- AI: draft description + why from the repository before creating ---
    const aiButton = root.querySelector<HTMLButtonElement>('[data-create-ai]')!;
    const aiStatus = root.querySelector<HTMLElement>('[data-create-ai-status]')!;
    const control = (name: string) => form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement;
    aiButton.addEventListener('click', async () => {
      const repositoryUrl = control('repositoryUrl').value.trim();
      const pullRequestUrl = control('pullRequestUrl').value.trim();
      if (!repositoryUrl && !pullRequestUrl) {
        aiStatus.textContent = 'Add a repository or pull request link first — the AI reads it for context.';
        return;
      }
      aiButton.disabled = true;
      try {
        aiStatus.textContent = 'Reading the repository…';
        const context = await gatherRepoContext(token, repositoryUrl, pullRequestUrl);
        const nameInput = control('name');
        if (!nameInput.value.trim() && repositoryUrl) {
          nameInput.value = (repositoryUrl.split('/').pop() ?? '').replace(/[-_]+/g, ' ').trim();
        }
        const projectName = nameInput.value.trim() || 'this project';
        aiStatus.textContent = 'Drafting the description…';
        control('description').value = await aiComplete({ field: 'description', existing: control('description').value, projectName, context });
        aiStatus.textContent = 'Drafting why it was built…';
        control('why').value = await aiComplete({ field: 'why', existing: control('why').value, projectName, context });
        aiStatus.textContent = `Drafted from ${describeLastEvidence()} — edit anything before creating.`;
      } catch (error) {
        aiStatus.textContent = (error as Error).message || 'The draft failed.';
      } finally {
        aiButton.disabled = false;
      }
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const formData = new FormData(form);
      const fields = {
        name: String(formData.get('name') ?? '').trim(),
        description: String(formData.get('description') ?? '').trim(),
        why: String(formData.get('why') ?? '').trim(),
        status: String(formData.get('status') ?? ''),
        startDate: String(formData.get('startDate') ?? ''),
        repositoryUrl: String(formData.get('repositoryUrl') ?? '').trim(),
        pullRequestUrl: String(formData.get('pullRequestUrl') ?? '').trim(),
      };
      // no repository yet -> the project can only be an idea
      if (!fields.repositoryUrl) fields.status = 'idea';
      if (!fields.name || !fields.description || !fields.why || !/^\d{4}-\d{2}-\d{2}$/.test(fields.startDate)) {
        status.textContent = 'Name, description, why, and a valid start date are required.';
        return;
      }
      const slug = fields.name.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
      if (!slug) { status.textContent = 'The name needs at least one letter or number.'; return; }

      const submit = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
      submit.disabled = true;
      status.textContent = 'Creating the project…';
      try {
        const folders = await listProjectFolders(token);
        if (folders.some((name) => name.replace(/^\d+-/, '') === slug)) {
          throw new Error('A project with that name already exists.');
        }
        const nextId = String(Math.max(0, ...folders.map((name) => Number(/^(\d+)/.exec(name)?.[1] ?? 0))) + 1).padStart(3, '0');
        const folder = `${nextId}-${slug}`;
        const metadata = {
          id: nextId,
          slug,
          name: fields.name,
          description: fields.description,
          why: fields.why,
          status: fields.status,
          privacy: 'public',
          startDate: fields.startDate,
          updatedDate: fields.startDate,
          ...(fields.repositoryUrl ? { repositoryUrl: fields.repositoryUrl } : {}),
          ...(fields.pullRequestUrl ? { pullRequestUrl: fields.pullRequestUrl } : {}),
        };
        const indexMd = `---\n${stringify(metadata, { lineWidth: 0 }).trimEnd()}\n---\n`;
        await putFile(token, `src/content/projects/${folder}/index.md`, encodeText(indexMd), `Add ${fields.name} from the hosted editor`);
        await putFile(token, `src/content/projects/${folder}/artifacts/.gitkeep`, '', `Add artifacts folder for ${fields.name}`);
        form.reset();
        status.innerHTML = '';
        const note = document.createElement('span');
        note.append('Created. The site rebuilds in about a minute — then it lives at ');
        const link = document.createElement('a');
        link.href = `${projectsBase}/${slug}`;
        link.textContent = `${projectsBase}/${slug}`;
        note.append(link, '.');
        status.append(note);
      } catch (error) {
        if ((error as { status?: number }).status === 401) {
          clearToken();
          status.textContent = 'GitHub rejected the token — reconnect with the connections icon in the header.';
          return;
        }
        status.textContent = (error as Error).message || 'The project could not be created.';
      } finally {
        submit.disabled = false;
      }
    });
  }
</script>
