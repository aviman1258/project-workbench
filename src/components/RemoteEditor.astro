---
import type { CollectionEntry } from 'astro:content';
import { projectStatuses } from '../lib/project-schema';

// Invisible machinery for hosted-site editing: inline field edits (pencils),
// direct media upload from the ＋ Add media button, per-slide delete, and the
// featured-artifact star. Every action commits to GitHub; the token lives behind
// the header's GitHub icon.
interface Props {
  project: CollectionEntry<'projects'>;
  folder: string;
}

const { folder } = Astro.props;
---

<div data-remote-editor data-project-folder={folder} data-statuses={projectStatuses.join(',')} hidden>
  <input type="file" multiple accept=".png,.jpg,.jpeg,.pdf,.mp4" data-remote-media-input />
</div>

<script>
  import { parse, stringify } from 'yaml';
  import { TOKEN_EVENT, encodeText, getFile, getStoredToken, putFile, deleteFile } from '../lib/github-client';

  const root = document.querySelector<HTMLElement>('[data-remote-editor]');
  if (root) {
    const folder = root.dataset.projectFolder ?? '';
    const statuses = (root.dataset.statuses ?? '').split(',').filter(Boolean);
    const indexPath = `src/content/projects/${folder}/index.md`;
    const mediaStatus = document.querySelector<HTMLElement>('[data-media-status]');

    let token = getStoredToken();
    window.addEventListener(TOKEN_EVENT, () => { token = getStoredToken(); });

    const setStatus = (message: string) => { if (mediaStatus) mediaStatus.textContent = message; };
    // no token: open the header's GitHub dialog instead of failing silently
    const requireToken = () => {
      if (token) return true;
      document.querySelector<HTMLDialogElement>('[data-token-dialog]')?.showModal();
      return false;
    };
    const handleAuthFailure = (error: unknown) => {
      if ((error as { status?: number }).status === 401) {
        document.querySelector<HTMLDialogElement>('[data-token-dialog]')?.showModal();
      }
    };

    const patchOnce = async (mutate: (metadata: Record<string, unknown>) => void, message: string) => {
      const { sha, text } = await getFile(token, indexPath);
      const match = /^---\r?\n([\s\S]*?)\r?\n---\r?\n?/.exec(text);
      if (!match) throw new Error('index.md is missing YAML front matter.');
      const metadata = { ...(parse(match[1]) as Record<string, unknown>) };
      mutate(metadata);
      metadata.updatedDate = new Date().toISOString().slice(0, 10);
      for (const key of Object.keys(metadata)) {
        if (metadata[key] === undefined) delete metadata[key];
      }
      const body = text.slice(match[0].length).replace(/^\r?\n/, '');
      const next = `---\n${stringify(metadata, { lineWidth: 0 }).trimEnd()}\n---\n${body ? `\n${body}` : ''}`;
      await putFile(token, indexPath, encodeText(next), message, sha);
    };
    // right after a commit, the contents API can briefly serve the previous file,
    // making a quick follow-up edit fail on a stale sha — wait and retry once
    const patchFrontmatter = async (mutate: (metadata: Record<string, unknown>) => void, message: string) => {
      try {
        await patchOnce(mutate, message);
      } catch (error) {
        if ((error as { status?: number }).status !== 409) throw error;
        await new Promise((resolve) => setTimeout(resolve, 2000));
        await patchOnce(mutate, message);
      }
    };

    // --- inline field editing (pencil buttons) ---
    const FIELDS: Record<string, { kind: 'input' | 'textarea' | 'select' | 'date'; max?: number; rows?: number }> = {
      name: { kind: 'input', max: 120 },
      description: { kind: 'textarea', max: 500, rows: 3 },
      why: { kind: 'textarea', max: 3000, rows: 6 },
      status: { kind: 'select' },
      startDate: { kind: 'date' },
    };
    const displayFor = (field: string) => document.querySelector<HTMLElement>(`[data-field-display="${field}"]`);
    const currentValue = (field: string) => {
      const display = displayFor(field);
      if (!display) return '';
      return display.dataset.value ?? display.textContent?.trim() ?? '';
    };
    const applyDisplay = (field: string, value: string) => {
      const display = displayFor(field);
      if (!display) return;
      if (field === 'status') {
        display.dataset.value = value;
        display.textContent = value.replaceAll('-', ' ');
        const badge = document.querySelector<HTMLElement>('.status-badge');
        if (badge) {
          badge.className = `status-badge status-badge--${value}`;
          badge.textContent = value.replaceAll('-', ' ');
        }
      } else if (field === 'startDate') {
        display.dataset.value = value;
        display.textContent = new Date(`${value}T00:00:00`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
      } else {
        display.textContent = value;
        if (field === 'name') document.title = `${value} · Avishek's Portfolio`;
      }
    };

    document.querySelectorAll<HTMLButtonElement>('[data-inline-edit]').forEach((pencil) => {
      pencil.addEventListener('click', () => {
        const field = pencil.dataset.inlineEdit ?? '';
        const spec = FIELDS[field];
        const display = displayFor(field);
        if (!spec || !display || !requireToken()) return;
        if (document.querySelector('.inline-editor')) return; // one edit at a time

        const editor = document.createElement('div');
        editor.className = 'inline-editor';
        let control: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
        if (spec.kind === 'textarea') {
          const textarea = document.createElement('textarea');
          textarea.rows = spec.rows ?? 4;
          textarea.maxLength = spec.max ?? 3000;
          textarea.value = currentValue(field);
          control = textarea;
        } else if (spec.kind === 'select') {
          const select = document.createElement('select');
          for (const value of statuses) {
            const option = document.createElement('option');
            option.value = value;
            option.textContent = value.replaceAll('-', ' ');
            option.selected = value === currentValue(field);
            select.append(option);
          }
          control = select;
        } else {
          const input = document.createElement('input');
          input.type = spec.kind === 'date' ? 'date' : 'text';
          if (spec.max) input.maxLength = spec.max;
          input.value = currentValue(field);
          control = input;
        }
        const save = document.createElement('button');
        save.type = 'button';
        save.className = 'inline-editor__save';
        save.textContent = 'Save';
        const cancel = document.createElement('button');
        cancel.type = 'button';
        cancel.className = 'inline-editor__cancel';
        cancel.textContent = 'Cancel';
        const note = document.createElement('span');
        note.className = 'inline-editor__note';
        const actions = document.createElement('div');
        actions.className = 'inline-editor__actions';
        actions.append(save, cancel, note);
        editor.append(control, actions);

        display.hidden = true;
        pencil.hidden = true;
        display.insertAdjacentElement('afterend', editor);
        control.focus();

        const closeEditor = () => {
          editor.remove();
          display.hidden = false;
          pencil.hidden = false;
        };
        cancel.addEventListener('click', closeEditor);
        save.addEventListener('click', async () => {
          const value = control.value.trim();
          if (!value) { note.textContent = 'A value is required.'; return; }
          if (spec.kind === 'date' && !/^\d{4}-\d{2}-\d{2}$/.test(value)) { note.textContent = 'Use a valid date.'; return; }
          save.disabled = true;
          note.textContent = 'Committing…';
          try {
            await patchFrontmatter((metadata) => { metadata[field] = value; }, `Update ${field} from the hosted editor`);
            applyDisplay(field, value);
            closeEditor();
            setStatus('Saved. The site rebuilds in about a minute.');
          } catch (error) {
            handleAuthFailure(error);
            note.textContent = (error as Error).message || 'The commit failed.';
            save.disabled = false;
          }
        });
      });
    });

    // --- add media: the ＋ Add media button opens the picker directly ---
    const mediaInput = root.querySelector<HTMLInputElement>('[data-remote-media-input]')!;
    document.querySelector('[data-remote-media-open]')?.addEventListener('click', () => {
      if (requireToken()) mediaInput.click();
    });
    mediaInput.addEventListener('change', async () => {
      const files = [...(mediaInput.files ?? [])].filter((file) => /\.(png|jpe?g|pdf|mp4)$/i.test(file.name) && file.size <= 20 * 1024 * 1024);
      mediaInput.value = '';
      if (!files.length) { setStatus('PNG, JPG, PDF, or MP4 up to 20 MB.'); return; }
      try {
        for (const [index, file] of files.entries()) {
          const extension = file.name.slice(file.name.lastIndexOf('.')).toLowerCase();
          const stem = file.name.slice(0, file.name.lastIndexOf('.')).replace(/[^a-zA-Z0-9._-]+/g, '-') || 'media';
          const stamp = new Date().toISOString().replace(/[-:T]/g, '').slice(0, 14);
          const filename = `${stem}-${stamp}${extension}`;
          setStatus(`Uploading ${filename} (${index + 1} of ${files.length})…`);
          const dataUrl = await new Promise<string>((resolve, reject) => {
            const reader = new FileReader();
            reader.addEventListener('load', () => resolve(String(reader.result)));
            reader.addEventListener('error', () => reject(new Error(`${file.name} could not be read.`)));
            reader.readAsDataURL(file);
          });
          await putFile(token, `src/content/projects/${folder}/artifacts/${filename}`, dataUrl.slice(dataUrl.indexOf(',') + 1), `Add ${filename} from the hosted editor`);
          await patchFrontmatter((metadata) => {
            if (!metadata.featuredArtifact) metadata.featuredArtifact = filename;
          }, `Touch updated date for ${filename}`);
        }
        setStatus('Committed. The carousel updates after the site rebuilds in about a minute.');
      } catch (error) {
        handleAuthFailure(error);
        setStatus((error as Error).message || 'The upload failed.');
      }
    });

    // --- featured-artifact star ---
    document.querySelectorAll<HTMLButtonElement>('[data-media-feature-trigger]').forEach((trigger) => {
      trigger.addEventListener('click', async () => {
        const filename = trigger.dataset.filename ?? '';
        if (!filename || trigger.dataset.featured === 'true' || !requireToken()) return;
        setStatus(`Featuring ${filename}…`);
        try {
          await patchFrontmatter((metadata) => { metadata.featuredArtifact = filename; }, `Feature ${filename}`);
          document.querySelectorAll<HTMLButtonElement>('[data-media-feature-trigger]').forEach((star) => {
            star.dataset.featured = String(star === trigger);
          });
          setStatus(`${filename} is now featured. The card updates after the site rebuilds.`);
        } catch (error) {
          handleAuthFailure(error);
          setStatus((error as Error).message || 'The artifact could not be featured.');
        }
      });
    });

    // --- delete via the per-slide trash button + shared confirm dialog ---
    const deleteDialog = document.querySelector<HTMLDialogElement>('[data-media-delete-dialog]');
    const deleteName = document.querySelector<HTMLElement>('[data-media-delete-name]');
    let pendingDelete = '';
    document.querySelectorAll<HTMLButtonElement>('[data-media-delete-trigger]').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        pendingDelete = trigger.dataset.filename ?? '';
        if (!pendingDelete || !deleteDialog) return;
        if (deleteName) deleteName.textContent = pendingDelete;
        deleteDialog.showModal();
      });
    });
    deleteDialog?.querySelector('[data-media-delete-cancel]')?.addEventListener('click', () => deleteDialog.close());
    deleteDialog?.querySelector<HTMLButtonElement>('[data-media-delete-confirm]')?.addEventListener('click', async (event) => {
      const confirmButton = event.currentTarget as HTMLButtonElement;
      if (!pendingDelete) return;
      if (!token) { deleteDialog.close(); requireToken(); return; }
      confirmButton.disabled = true;
      setStatus(`Deleting ${pendingDelete}…`);
      try {
        await deleteFile(token, `src/content/projects/${folder}/artifacts/${pendingDelete}`, `Delete ${pendingDelete} from the hosted editor`);
        const deleted = pendingDelete;
        const remaining = [...document.querySelectorAll<HTMLElement>('[data-media-delete-trigger]')]
          .map((trigger) => trigger.dataset.filename ?? '')
          .filter((name) => name && name !== deleted);
        await patchFrontmatter((metadata) => {
          if (Array.isArray(metadata.artifactOrder)) {
            metadata.artifactOrder = (metadata.artifactOrder as string[]).filter((name) => name !== deleted);
          }
          if (metadata.featuredArtifact === deleted) metadata.featuredArtifact = remaining[0];
        }, `Remove ${deleted} from artifact metadata`);
        deleteDialog.close();
        setStatus('Deleted. The carousel updates after the site rebuilds in about a minute.');
      } catch (error) {
        handleAuthFailure(error);
        deleteDialog.close();
        setStatus((error as Error).message || 'The artifact could not be deleted.');
      } finally {
        confirmButton.disabled = false;
      }
    });
  }
</script>
