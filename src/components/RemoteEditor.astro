---
import type { CollectionEntry } from 'astro:content';
import { projectStatuses } from '../lib/project-schema';
import { formatLabel } from '../lib/projects';
import GitHubConnect from './GitHubConnect.astro';

// Hosted-site editor: commits changes straight to the GitHub repo. The push
// triggers the Pages workflow, so saves appear on the site about a minute later.
interface Props {
  project: CollectionEntry<'projects'>;
  folder: string;
}

const { project, folder } = Astro.props;
const { data } = project;
---

<section class="project-editor" aria-labelledby="remote-editor-title">
  <div class="project-editor__intro">
    <div><p class="eyebrow">On-the-go editor</p><h2 id="remote-editor-title">Edit this project</h2></div>
    <p>Changes are committed to the GitHub repository; the site rebuilds itself in about a minute.</p>
  </div>

  <div class="project-editor__tools" data-remote-editor data-project-folder={folder}>
    <GitHubConnect />

    <details data-remote-edit-panel hidden>
      <summary><span aria-hidden="true">✦</span><span>Edit project details</span></summary>
      <form class="compact-form" data-remote-edit-form novalidate>
        <label class="field"><span>Name</span><input name="name" value={data.name} required maxlength="120" /></label>
        <label class="field"><span>Description</span><textarea name="description" required maxlength="500" rows="3">{data.description}</textarea></label>
        <label class="field"><span>Why it was built</span><textarea name="why" required maxlength="3000" rows="8">{data.why}</textarea></label>
        <div class="form-grid form-grid--two">
          <label class="field"><span>Status</span><select name="status" required>{projectStatuses.map((value) => <option value={value} selected={value === data.status}>{formatLabel(value)}</option>)}</select></label>
          <label class="field"><span>Start date</span><input name="startDate" type="date" value={data.startDate.toISOString().slice(0, 10)} required /></label>
        </div>
        <div class="compact-form__actions">
          <p class="form-status" data-remote-edit-status aria-live="assertive"></p>
          <button class="primary-button" type="submit">Commit changes</button>
        </div>
      </form>
    </details>

    <details data-remote-media-panel hidden>
      <summary><span aria-hidden="true">＋</span><span>Add media</span></summary>
      <div class="compact-form">
        <p class="remote-editor-hint">Photos, PDFs, or MP4s up to 20 MB. The file is committed to the project's artifacts folder.</p>
        <label class="field"><span>File</span><input type="file" accept=".png,.jpg,.jpeg,.pdf,.mp4" data-remote-media-input /></label>
        <div class="compact-form__actions">
          <p class="form-status" data-remote-media-status aria-live="assertive"></p>
          <button class="primary-button" type="button" data-remote-media-upload>Commit media</button>
        </div>
      </div>
    </details>
  </div>
</section>

<script>
  import { parse, stringify } from 'yaml';
  import { encodeText, getFile, putFile, wireTokenPanel } from '../lib/github-client';

  const root = document.querySelector<HTMLElement>('[data-remote-editor]');
  if (root) {
    const folder = root.dataset.projectFolder ?? '';
    const indexPath = `src/content/projects/${folder}/index.md`;
    const editPanel = root.querySelector<HTMLDetailsElement>('[data-remote-edit-panel]')!;
    const mediaPanel = root.querySelector<HTMLDetailsElement>('[data-remote-media-panel]')!;

    let token = '';
    const connection = wireTokenPanel(root, (next) => {
      token = next;
      editPanel.hidden = !token;
      mediaPanel.hidden = !token;
    });

    // The "＋ Add media" button in the artifacts section jumps to this editor.
    document.querySelector('[data-remote-media-open]')?.addEventListener('click', () => {
      const target = token ? mediaPanel : root.querySelector<HTMLDetailsElement>('[data-remote-token-panel]');
      if (target) target.open = true;
      root.scrollIntoView({ behavior: 'smooth', block: 'start' });
      if (token) root.querySelector<HTMLInputElement>('[data-remote-media-input]')?.focus();
    });
    const handleAuthFailure = (error: unknown) => {
      if ((error as { status?: number }).status === 401) connection.invalidate();
    };

    const patchFrontmatter = async (patch: Record<string, unknown>, message: string) => {
      const { sha, text } = await getFile(token, indexPath);
      const match = /^---\r?\n([\s\S]*?)\r?\n---\r?\n?/.exec(text);
      if (!match) throw new Error('index.md is missing YAML front matter.');
      const metadata = { ...(parse(match[1]) as Record<string, unknown>), ...patch, updatedDate: new Date().toISOString().slice(0, 10) };
      const body = text.slice(match[0].length).replace(/^\r?\n/, '');
      const next = `---\n${stringify(metadata, { lineWidth: 0 }).trimEnd()}\n---\n${body ? `\n${body}` : ''}`;
      await putFile(token, indexPath, encodeText(next), message, sha);
    };

    // --- edit fields ---
    const editForm = root.querySelector<HTMLFormElement>('[data-remote-edit-form]')!;
    const editStatus = root.querySelector<HTMLElement>('[data-remote-edit-status]')!;
    editForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const formData = new FormData(editForm);
      const fields = {
        name: String(formData.get('name') ?? '').trim(),
        description: String(formData.get('description') ?? '').trim(),
        why: String(formData.get('why') ?? '').trim(),
        status: String(formData.get('status') ?? ''),
        startDate: String(formData.get('startDate') ?? ''),
      };
      if (!fields.name || !fields.description || !fields.why || !/^\d{4}-\d{2}-\d{2}$/.test(fields.startDate)) {
        editStatus.textContent = 'Name, description, why, and a valid start date are required.';
        return;
      }
      const submit = editForm.querySelector<HTMLButtonElement>('button[type=submit]')!;
      submit.disabled = true;
      editStatus.textContent = 'Committing…';
      try {
        await patchFrontmatter(fields, `Update ${fields.name} from the hosted editor`);
        editStatus.textContent = 'Committed. The site rebuilds in about a minute.';
      } catch (error) {
        handleAuthFailure(error);
        editStatus.textContent = (error as Error).message || 'The commit failed.';
      } finally {
        submit.disabled = false;
      }
    });

    // --- add media ---
    const mediaInput = root.querySelector<HTMLInputElement>('[data-remote-media-input]')!;
    const mediaStatus = root.querySelector<HTMLElement>('[data-remote-media-status]')!;
    root.querySelector('[data-remote-media-upload]')?.addEventListener('click', async () => {
      const file = mediaInput.files?.[0];
      if (!file) { mediaStatus.textContent = 'Choose a file first.'; return; }
      if (!/\.(png|jpe?g|pdf|mp4)$/i.test(file.name)) { mediaStatus.textContent = 'PNG, JPG, PDF, or MP4 only.'; return; }
      if (file.size > 20 * 1024 * 1024) { mediaStatus.textContent = 'Keep files under 20 MB.'; return; }

      const extension = file.name.slice(file.name.lastIndexOf('.')).toLowerCase();
      const stem = file.name.slice(0, file.name.lastIndexOf('.')).replace(/[^a-zA-Z0-9._-]+/g, '-') || 'media';
      const stamp = new Date().toISOString().replace(/[-:T]/g, '').slice(0, 14);
      const filename = `${stem}-${stamp}${extension}`;

      mediaStatus.textContent = `Uploading ${filename}…`;
      try {
        const dataUrl = await new Promise<string>((resolve, reject) => {
          const reader = new FileReader();
          reader.addEventListener('load', () => resolve(String(reader.result)));
          reader.addEventListener('error', () => reject(new Error('The file could not be read.')));
          reader.readAsDataURL(file);
        });
        await putFile(
          token,
          `src/content/projects/${folder}/artifacts/${filename}`,
          dataUrl.slice(dataUrl.indexOf(',') + 1),
          `Add ${filename} from the hosted editor`,
        );
        await patchFrontmatter({}, `Touch updated date for ${filename}`);
        mediaInput.value = '';
        mediaStatus.textContent = 'Committed. The site rebuilds in about a minute.';
      } catch (error) {
        handleAuthFailure(error);
        mediaStatus.textContent = (error as Error).message || 'The upload failed.';
      }
    });
  }
</script>
