---
// Private project on the hosted site. The build only knows the project's id and
// dates; the real content lives in the private vault repo and is fetched
// client-side using the GitHub token from the header connection. Once unlocked,
// the page looks and edits exactly like a public project: the same modal field
// editors, and the same artifact carousel (star to feature, trash to delete,
// ＋ Add media) — except every save commits to the vault repo.
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<section class="project-editor private-vault" data-private-vault data-vault-id={id}>
  <p class="form-status" data-vault-status aria-live="polite">
    This project is private. Connect GitHub with the connections icon in the header to view it.
  </p>

  <article class="vault-content" data-vault-content hidden>
    <div class="section-heading section-heading--detail"><div><h2>Why it was built</h2></div></div>
    <div class="prose inline-editable">
      <p data-vault-why></p>
    </div>

    <section class="artifacts-section">
      <div class="section-heading section-heading--detail">
        <div>
          <h2>Evidence from the work</h2>
          <p>Images, documents, and recordings stored alongside this project.</p>
          <button type="button" class="media-add-button" data-vault-media-add>＋ Add media</button>
        </div>
      </div>
      <input type="file" multiple accept=".png,.jpg,.jpeg,.pdf,.mp4" hidden data-vault-media-input />
      <p class="form-status media-status" data-vault-media-status aria-live="assertive"></p>
      <div data-vault-carousel></div>
    </section>
  </article>

  <dialog class="media-delete-dialog" data-vault-delete-dialog>
    <h3>Delete this artifact?</h3>
    <p><strong data-vault-delete-name></strong> will be removed from the private vault. This cannot be undone.</p>
    <div class="media-delete-dialog__actions">
      <button type="button" class="media-delete-dialog__cancel" data-vault-delete-cancel>Cancel</button>
      <button type="button" class="media-delete-dialog__confirm" data-vault-delete-confirm>Delete</button>
    </div>
  </dialog>
</section>

<script>
  import { parse, stringify } from 'yaml';
  import { TOKEN_EVENT, deleteVaultFile, encodeText, findVaultFolder, getStoredToken, getVaultFile, getVaultText, getVaultBlobUrl, listVaultArtifacts, putVaultFile } from '../lib/github-client';
  import { artifactKind, carouselHtml, renderPdfPreviews, wireCarousel, type CarouselArtifact } from '../lib/artifact-carousel';
  import { openFieldEditor } from '../lib/field-editor';
  import { aiComplete, describeLastEvidence, gatherRepoContext } from '../lib/ai-complete';

  const root = document.querySelector<HTMLElement>('[data-private-vault]');
  if (root) {
    const id = root.dataset.vaultId ?? '';
    const status = root.querySelector<HTMLElement>('[data-vault-status]')!;
    const content = root.querySelector<HTMLElement>('[data-vault-content]')!;
    const whyEl = root.querySelector<HTMLElement>('[data-vault-why]')!;
    const carouselHost = root.querySelector<HTMLElement>('[data-vault-carousel]')!;
    const mediaStatus = root.querySelector<HTMLElement>('[data-vault-media-status]')!;
    let loaded = false;

    const mime = (name: string) =>
      /\.pdf$/i.test(name) ? 'application/pdf'
      : /\.mp4$/i.test(name) ? 'video/mp4'
      : /\.png$/i.test(name) ? 'image/png'
      : 'image/jpeg';

    // Set at unlock; the media and field handlers below need them afterwards.
    let vaultToken = '';
    let vaultFolder = '';

    // Reads index.md, applies the mutation to the front matter, writes it back.
    const patchVaultMeta = async (mutate: (metadata: Record<string, unknown>) => void, message: string) => {
      const indexPath = `projects/${vaultFolder}/index.md`;
      const { sha, text } = await getVaultFile(vaultToken, indexPath);
      const match = /^---\r?\n([\s\S]*?)\r?\n---\r?\n?/.exec(text);
      if (!match) throw new Error('index.md is missing YAML front matter.');
      const metadata = { ...(parse(match[1]) as Record<string, unknown>) };
      mutate(metadata);
      metadata.updatedDate = new Date().toISOString().slice(0, 10);
      for (const key of Object.keys(metadata)) {
        if (metadata[key] === undefined) delete metadata[key];
      }
      const body = text.slice(match[0].length).replace(/^\r?\n/, '');
      const next = `---\n${stringify(metadata, { lineWidth: 0 }).trimEnd()}\n---\n${body ? `\n${body}` : ''}`;
      await putVaultFile(vaultToken, indexPath, encodeText(next), message, sha);
    };

    // --- media: the same carousel as public projects, backed by the vault ---

    // GitHub's contents listing can lag a just-made commit, so after an add or
    // delete we re-list until the expected count shows up.
    let lastMediaCount = 0;
    const loadMediaSettled = async (expected: number) => {
      for (let attempt = 0; attempt < 5; attempt++) {
        if ((await loadMedia()) === expected) return;
        await new Promise((resolve) => setTimeout(resolve, 1500));
      }
    };

    const loadMedia = async () => {
      const text = await getVaultText(vaultToken, `projects/${vaultFolder}/index.md`);
      const match = /^---\r?\n([\s\S]*?)\r?\n---/.exec(text);
      const metadata = match ? (parse(match[1]) as Record<string, unknown>) : {};
      const order = Array.isArray(metadata.artifactOrder) ? (metadata.artifactOrder as string[]) : [];
      const rank = (name: string) => { const index = order.indexOf(name); return index === -1 ? Number.MAX_SAFE_INTEGER : index; };

      const entries = (await listVaultArtifacts(vaultToken, vaultFolder))
        .sort((a, b) => rank(a.name) - rank(b.name) || a.name.localeCompare(b.name));
      const artifacts: CarouselArtifact[] = [];
      for (const entry of entries) {
        artifacts.push({
          filename: entry.name,
          kind: artifactKind(entry.name),
          href: await getVaultBlobUrl(vaultToken, entry.path, mime(entry.name)),
          featured: false,
        });
      }
      const stored = typeof metadata.featuredArtifact === 'string' ? metadata.featuredArtifact : '';
      const featuredName = artifacts.some((a) => a.filename === stored) ? stored : artifacts[0]?.filename;
      for (const artifact of artifacts) artifact.featured = artifact.filename === featuredName;

      carouselHost.innerHTML = carouselHtml(artifacts, { lockBadge: true });
      const carousel = carouselHost.querySelector<HTMLElement>('[data-artifact-carousel]');
      if (carousel) {
        wireCarousel(carousel);
        void renderPdfPreviews(carouselHost);
        bindMediaActions(carouselHost);
      }
      lastMediaCount = artifacts.length;
      return artifacts.length;
    };

    const bindMediaActions = (scope: HTMLElement) => {
      scope.querySelectorAll<HTMLButtonElement>('[data-media-feature-trigger]').forEach((star) => {
        star.addEventListener('click', async () => {
          const filename = star.dataset.filename ?? '';
          if (!filename || star.dataset.featured === 'true') return;
          mediaStatus.textContent = 'Saving the featured artifact…';
          try {
            await patchVaultMeta((metadata) => { metadata.featuredArtifact = filename; }, `Feature ${filename}`);
            scope.querySelectorAll<HTMLButtonElement>('[data-media-feature-trigger]').forEach((other) => {
              other.dataset.featured = String(other.dataset.filename === filename);
            });
            mediaStatus.textContent = '';
          } catch (error) {
            mediaStatus.textContent = (error as Error).message || 'The featured artifact could not be saved.';
          }
        });
      });
      scope.querySelectorAll<HTMLButtonElement>('[data-media-delete-trigger]').forEach((trash) => {
        trash.addEventListener('click', () => {
          const filename = trash.dataset.filename ?? '';
          if (filename) confirmDelete(filename, `projects/${vaultFolder}/artifacts/${filename}`);
        });
      });
    };

    const deleteDialog = root.querySelector<HTMLDialogElement>('[data-vault-delete-dialog]')!;
    const deleteNameEl = root.querySelector<HTMLElement>('[data-vault-delete-name]')!;
    let pendingDelete: { name: string; path: string } | null = null;
    const confirmDelete = (name: string, path: string) => {
      pendingDelete = { name, path };
      deleteNameEl.textContent = name;
      deleteDialog.showModal();
    };
    root.querySelector('[data-vault-delete-cancel]')?.addEventListener('click', () => deleteDialog.close());
    deleteDialog.addEventListener('click', (event) => { if (event.target === deleteDialog) deleteDialog.close(); });
    root.querySelector('[data-vault-delete-confirm]')?.addEventListener('click', async () => {
      if (!pendingDelete || !vaultToken) return;
      const { name, path } = pendingDelete;
      deleteDialog.close();
      mediaStatus.textContent = `Deleting ${name}…`;
      try {
        await deleteVaultFile(vaultToken, path, `Delete ${name} from the private project`);
        await patchVaultMeta((metadata) => {
          if (Array.isArray(metadata.artifactOrder)) {
            metadata.artifactOrder = (metadata.artifactOrder as string[]).filter((entry) => entry !== name);
          }
          if (metadata.featuredArtifact === name) delete metadata.featuredArtifact;
        }, `Remove ${name} from the artifact order`);
        await loadMediaSettled(lastMediaCount - 1);
        mediaStatus.textContent = '';
      } catch (error) {
        mediaStatus.textContent = (error as Error).message || `${name} could not be deleted.`;
      }
    });

    const fileToBase64 = (file: File) => new Promise<string>((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(String(reader.result).split(',')[1] ?? '');
      reader.onerror = () => reject(new Error(`${file.name} could not be read.`));
      reader.readAsDataURL(file);
    });

    const addButton = root.querySelector<HTMLButtonElement>('[data-vault-media-add]')!;
    const fileInput = root.querySelector<HTMLInputElement>('[data-vault-media-input]')!;
    addButton.addEventListener('click', () => fileInput.click());
    fileInput.addEventListener('change', async () => {
      const files = [...(fileInput.files ?? [])];
      fileInput.value = '';
      if (!files.length || !vaultToken) return;
      const uploaded: string[] = [];
      for (const file of files) {
        const name = file.name.replace(/[^a-zA-Z0-9._-]/g, '-');
        mediaStatus.textContent = `Uploading ${name}…`;
        try {
          await putVaultFile(vaultToken, `projects/${vaultFolder}/artifacts/${name}`, await fileToBase64(file), `Add ${name} to the private project`);
          uploaded.push(name);
        } catch (error) {
          mediaStatus.textContent = /already exists|sha/i.test((error as Error).message ?? '')
            ? `${name} already exists in the vault — rename the file to replace it.`
            : `${name}: ${(error as Error).message}`;
          return;
        }
      }
      try {
        await patchVaultMeta((metadata) => {
          const order = Array.isArray(metadata.artifactOrder) ? (metadata.artifactOrder as string[]) : [];
          metadata.artifactOrder = [...order, ...uploaded.filter((name) => !order.includes(name))];
          if (typeof metadata.featuredArtifact !== 'string' && lastMediaCount === 0 && uploaded[0]) {
            metadata.featuredArtifact = uploaded[0];
          }
        }, `Add ${uploaded.join(', ')} to the artifact order`);
      } catch { /* ordering metadata is best-effort — the files are already committed */ }
      mediaStatus.textContent = 'Refreshing media…';
      await loadMediaSettled(lastMediaCount + uploaded.length);
      mediaStatus.textContent = '';
    });

    // --- unlock: fetch the real content once a token can see the vault ---
    const unlock = async (token: string) => {
      if (loaded || !token) return;
      status.textContent = 'Unlocking…';
      try {
        const folder = await findVaultFolder(token, id);
        if (!folder) throw new Error('This account cannot see the private project.');
        const text = await getVaultText(token, `projects/${folder}/index.md`);
        const match = /^---\r?\n([\s\S]*?)\r?\n---/.exec(text);
        const metadata = match ? (parse(match[1]) as Record<string, unknown>) : {};

        const hero = document.querySelector('.project-hero__main');
        const title = hero?.querySelector('h1');
        const description = hero?.querySelector('p');
        if (title && typeof metadata.name === 'string') title.textContent = metadata.name;
        if (description && typeof metadata.description === 'string') description.textContent = metadata.description;
        whyEl.textContent = typeof metadata.why === 'string' ? metadata.why : '';
        for (const field of ['repositoryUrl', 'pullRequestUrl']) {
          const display = document.querySelector<HTMLElement>(`[data-field-display="${field}"]`);
          const value = typeof metadata[field] === 'string' ? (metadata[field] as string) : '';
          if (display && value) {
            display.dataset.value = value;
            display.replaceChildren();
            const link = document.createElement('a');
            link.href = value;
            link.target = '_blank';
            link.rel = 'noreferrer';
            link.textContent = value.replace(/^https:\/\/(www\.)?/, '');
            display.append(link);
          }
        }

        content.hidden = false;
        status.textContent = 'Loading media…';
        vaultToken = token;
        vaultFolder = folder;
        await loadMedia();
        status.textContent = '';
        loaded = true;
        enableVaultEditing();
      } catch (error) {
        status.textContent = (error as Error).message || 'The private content could not be loaded.';
      }
    };

    // --- editing after unlock: pencils opening the shared modal, committing to the vault ---
    const PENCIL = `<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.85 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"></path></svg>`;
    const VAULT_FIELDS: Record<string, { kind: 'input' | 'textarea' | 'status' | 'date' | 'url'; label: string; max?: number; rows?: number }> = {
      name: { kind: 'input', label: 'name', max: 120 },
      description: { kind: 'textarea', label: 'description', max: 500, rows: 4 },
      why: { kind: 'textarea', label: 'why it was built', max: 3000, rows: 8 },
      status: { kind: 'status', label: 'status' },
      startDate: { kind: 'date', label: 'start date' },
      repositoryUrl: { kind: 'url', label: 'repository link' },
      pullRequestUrl: { kind: 'url', label: 'pull request link' },
    };
    const STATUSES = ['idea', 'dev', 'review', 'delivered'];

    function enableVaultEditing() {
      const displayFor = (field: string) =>
        field === 'why' ? whyEl : document.querySelector<HTMLElement>(`[data-field-display="${field}"]`);
      const currentValue = (field: string) => {
        const display = displayFor(field);
        return display?.dataset.value ?? display?.textContent?.trim() ?? '';
      };

      for (const [field, spec] of Object.entries(VAULT_FIELDS)) {
        const display = displayFor(field);
        const wrapper = display?.closest('.inline-editable') ?? display?.parentElement;
        if (!display || !wrapper || wrapper.querySelector('.inline-edit')) continue;
        wrapper.classList.add('inline-editable');
        const pencil = document.createElement('button');
        pencil.type = 'button';
        pencil.className = 'inline-edit';
        pencil.setAttribute('aria-label', `Edit the ${spec.label}`);
        pencil.innerHTML = PENCIL;
        wrapper.append(pencil);

        pencil.addEventListener('click', () => {
          const hasRepo = Boolean(currentValue('repositoryUrl'));
          const supportsAi = (field === 'description' || field === 'why') && Boolean(currentValue('repositoryUrl') || currentValue('pullRequestUrl'));
          openFieldEditor({
            spec,
            current: currentValue(field),
            statuses: field === 'status' ? (hasRepo ? STATUSES : ['idea']) : undefined,
            statusNote: field === 'status' && !hasRepo ? 'Add a repository link to move this project beyond Idea.' : undefined,
            aiComplete: supportsAi
              ? async (existing) => {
                  const context = await gatherRepoContext(vaultToken, currentValue('repositoryUrl'), currentValue('pullRequestUrl'));
                  return aiComplete({ field: field as 'description' | 'why', existing, projectName: currentValue('name'), context });
                }
              : undefined,
            aiEvidenceNote: describeLastEvidence,
            onApply: async (value) => {
              await patchVaultMeta((metadata) => {
                if ((field === 'repositoryUrl' || field === 'pullRequestUrl') && !value) delete metadata[field];
                else metadata[field] = value;
                if (field === 'repositoryUrl' && !value) metadata.status = 'idea';
              }, `Update private ${spec.label}`);
              if (field === 'status') {
                display.dataset.value = value;
                display.textContent = value.replaceAll('-', ' ');
                const badge = document.querySelector<HTMLElement>('.status-badge');
                if (badge) { badge.className = `status-badge status-badge--${value}`; badge.textContent = value.replaceAll('-', ' '); }
              } else if (field === 'startDate') {
                display.dataset.value = value;
                display.textContent = new Date(`${value}T00:00:00`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
              } else if (field === 'repositoryUrl' || field === 'pullRequestUrl') {
                display.dataset.value = value;
                display.replaceChildren();
                if (value) {
                  const link = document.createElement('a');
                  link.href = value;
                  link.target = '_blank';
                  link.rel = 'noreferrer';
                  link.textContent = value.replace(/^https:\/\/(www\.)?/, '');
                  display.append(link);
                } else {
                  display.textContent = '—';
                }
              } else {
                display.textContent = value;
              }
              status.textContent = 'Saved to the private vault.';
            },
          });
        });
      }
    }

    // unlock straight from the header connection — no separate panel here
    void unlock(getStoredToken());
    window.addEventListener(TOKEN_EVENT, () => void unlock(getStoredToken()));
  }
</script>
