---
import GitHubConnect from './GitHubConnect.astro';

// Locked view of a private project on the hosted site. The build only knows the
// project's id and dates; everything else lives in the private vault repo and is
// fetched client-side after the viewer connects an authorized GitHub token.
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<section class="project-editor private-vault" aria-labelledby="private-vault-title" data-private-vault data-vault-id={id}>
  <div class="project-editor__intro">
    <div><p class="eyebrow">Private project</p><h2 id="private-vault-title">Locked</h2></div>
    <p>The write-up and media live in a private repository. Connect GitHub with an authorized account to view them here.</p>
  </div>

  <div class="project-editor__tools">
    <GitHubConnect />
    <p class="form-status" data-vault-status aria-live="polite"></p>
  </div>

  <article class="vault-content" data-vault-content hidden>
    <div class="section-heading section-heading--detail"><div><h2>Why it was built</h2></div></div>
    <div class="prose"><p data-vault-why></p></div>

    <div class="vault-media" data-vault-media></div>
  </article>
</section>

<script>
  import { parse, stringify } from 'yaml';
  import { encodeText, findVaultFolder, getVaultFile, getVaultText, getVaultBlobUrl, listVaultArtifacts, putVaultFile, wireTokenPanel } from '../lib/github-client';

  const root = document.querySelector<HTMLElement>('[data-private-vault]');
  if (root) {
    const id = root.dataset.vaultId ?? '';
    const status = root.querySelector<HTMLElement>('[data-vault-status]')!;
    const content = root.querySelector<HTMLElement>('[data-vault-content]')!;
    const whyEl = root.querySelector<HTMLElement>('[data-vault-why]')!;
    const mediaEl = root.querySelector<HTMLElement>('[data-vault-media]')!;
    let loaded = false;

    const mime = (name: string) =>
      /\.pdf$/i.test(name) ? 'application/pdf'
      : /\.mp4$/i.test(name) ? 'video/mp4'
      : /\.png$/i.test(name) ? 'image/png'
      : 'image/jpeg';

    const unlock = async (token: string) => {
      if (loaded || !token) return;
      status.textContent = 'Unlocking…';
      try {
        const folder = await findVaultFolder(token, id);
        if (!folder) throw new Error('This account cannot see the private project.');
        const text = await getVaultText(token, `projects/${folder}/index.md`);
        const match = /^---\r?\n([\s\S]*?)\r?\n---/.exec(text);
        const metadata = match ? (parse(match[1]) as Record<string, unknown>) : {};

        // reveal the real name and description in the hero
        const hero = document.querySelector('.project-hero__main');
        const title = hero?.querySelector('h1');
        const description = hero?.querySelector('p');
        if (title && typeof metadata.name === 'string') title.textContent = metadata.name;
        if (description && typeof metadata.description === 'string') description.textContent = metadata.description;
        whyEl.textContent = typeof metadata.why === 'string' ? metadata.why : '';

        content.hidden = false;
        status.textContent = 'Loading media…';
        const artifacts = await listVaultArtifacts(token, folder);
        mediaEl.replaceChildren();
        for (const artifact of artifacts) {
          const url = await getVaultBlobUrl(token, artifact.path, mime(artifact.name));
          let element: HTMLElement;
          if (/\.mp4$/i.test(artifact.name)) {
            const video = document.createElement('video');
            video.src = url;
            video.controls = true;
            element = video;
          } else if (/\.pdf$/i.test(artifact.name)) {
            const link = document.createElement('a');
            link.href = url;
            link.target = '_blank';
            link.rel = 'noreferrer';
            link.className = 'vault-media__pdf';
            link.textContent = `▤ ${artifact.name} (open PDF)`;
            element = link;
          } else {
            const img = document.createElement('img');
            img.src = url;
            img.alt = artifact.name;
            element = img;
          }
          const figure = document.createElement('figure');
          figure.append(element);
          const caption = document.createElement('figcaption');
          caption.textContent = artifact.name;
          figure.append(caption);
          mediaEl.append(figure);
        }
        if (!artifacts.length) {
          const empty = document.createElement('p');
          empty.className = 'remote-editor-hint';
          empty.textContent = 'No media attached to this project.';
          mediaEl.append(empty);
        }
        status.textContent = 'Unlocked.';
        loaded = true;
        enableVaultEditing(token, folder);
      } catch (error) {
        status.textContent = (error as Error).message || 'The private content could not be loaded.';
      }
    };

    // --- inline editing after unlock: pencils that commit to the vault repo ---
    const PENCIL = `<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.85 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"></path></svg>`;
    const VAULT_FIELDS: Record<string, { kind: 'input' | 'textarea' | 'select' | 'date'; max?: number; rows?: number }> = {
      name: { kind: 'input', max: 120 },
      description: { kind: 'textarea', max: 500, rows: 3 },
      why: { kind: 'textarea', max: 3000, rows: 6 },
      status: { kind: 'select' },
      startDate: { kind: 'date' },
    };
    const STATUSES = ['idea', 'dev', 'review', 'delivered'];

    function enableVaultEditing(token: string, folder: string) {
      const indexPath = `projects/${folder}/index.md`;
      const patchVault = async (mutate: (metadata: Record<string, unknown>) => void, message: string) => {
        const { sha, text } = await getVaultFile(token, indexPath);
        const match = /^---\r?\n([\s\S]*?)\r?\n---\r?\n?/.exec(text);
        if (!match) throw new Error('index.md is missing YAML front matter.');
        const metadata = { ...(parse(match[1]) as Record<string, unknown>) };
        mutate(metadata);
        metadata.updatedDate = new Date().toISOString().slice(0, 10);
        const body = text.slice(match[0].length).replace(/^\r?\n/, '');
        const next = `---\n${stringify(metadata, { lineWidth: 0 }).trimEnd()}\n---\n${body ? `\n${body}` : ''}`;
        await putVaultFile(token, indexPath, encodeText(next), message, sha);
      };

      const displayFor = (field: string) =>
        field === 'why' ? whyEl : document.querySelector<HTMLElement>(`[data-field-display="${field}"]`);

      for (const [field, spec] of Object.entries(VAULT_FIELDS)) {
        const display = displayFor(field);
        const wrapper = display?.closest('.inline-editable') ?? display?.parentElement;
        if (!display || !wrapper || wrapper.querySelector('.inline-edit')) continue;
        wrapper.classList.add('inline-editable');
        const pencil = document.createElement('button');
        pencil.type = 'button';
        pencil.className = 'inline-edit';
        pencil.setAttribute('aria-label', `Edit the ${field}`);
        pencil.innerHTML = PENCIL;
        wrapper.append(pencil);

        pencil.addEventListener('click', () => {
          if (document.querySelector('.inline-editor')) return;
          const current = display.dataset.value ?? display.textContent?.trim() ?? '';
          const editor = document.createElement('div');
          editor.className = 'inline-editor';
          let control: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
          if (spec.kind === 'textarea') {
            const textarea = document.createElement('textarea');
            textarea.rows = spec.rows ?? 4;
            textarea.maxLength = spec.max ?? 3000;
            textarea.value = current;
            control = textarea;
          } else if (spec.kind === 'select') {
            const select = document.createElement('select');
            for (const value of STATUSES) {
              const option = document.createElement('option');
              option.value = value;
              option.textContent = value;
              option.selected = value === current;
              select.append(option);
            }
            control = select;
          } else {
            const input = document.createElement('input');
            input.type = spec.kind === 'date' ? 'date' : 'text';
            if (spec.max) input.maxLength = spec.max;
            input.value = current;
            control = input;
          }
          const save = document.createElement('button');
          save.type = 'button';
          save.className = 'inline-editor__save';
          save.textContent = 'Save';
          const cancel = document.createElement('button');
          cancel.type = 'button';
          cancel.className = 'inline-editor__cancel';
          cancel.textContent = 'Cancel';
          const note = document.createElement('span');
          note.className = 'inline-editor__note';
          const actions = document.createElement('div');
          actions.className = 'inline-editor__actions';
          actions.append(save, cancel, note);
          editor.append(control, actions);
          display.hidden = true;
          pencil.hidden = true;
          display.insertAdjacentElement('afterend', editor);
          control.focus();

          const closeEditor = () => { editor.remove(); display.hidden = false; pencil.hidden = false; };
          cancel.addEventListener('click', closeEditor);
          save.addEventListener('click', async () => {
            const value = control.value.trim();
            if (!value) { note.textContent = 'A value is required.'; return; }
            if (spec.kind === 'date' && !/^\d{4}-\d{2}-\d{2}$/.test(value)) { note.textContent = 'Use a valid date.'; return; }
            save.disabled = true;
            note.textContent = 'Committing…';
            try {
              await patchVault((metadata) => { metadata[field] = value; }, `Update private ${field}`);
              if (field === 'status') {
                display.dataset.value = value;
                display.textContent = value;
                const badge = document.querySelector<HTMLElement>('.status-badge');
                if (badge) { badge.className = `status-badge status-badge--${value}`; badge.textContent = value; }
              } else if (field === 'startDate') {
                display.dataset.value = value;
                display.textContent = new Date(`${value}T00:00:00`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
              } else {
                display.textContent = value;
              }
              closeEditor();
              status.textContent = 'Saved to the private vault.';
            } catch (error) {
              note.textContent = (error as Error).message || 'The commit failed.';
              save.disabled = false;
            }
          });
        });
      }
    }

    wireTokenPanel(root, (token) => { void unlock(token); });
  }
</script>
