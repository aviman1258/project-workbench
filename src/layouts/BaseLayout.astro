---
import globalStyles from '../styles/global.css?url';
import { publicOnlyBuild, withBase } from '../lib/projects';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Avishek's Portfolio",
  description = 'A private, local-first record of product ideas, experiments, and shipped work.',
} = Astro.props;
const pageTitle = title === "Avishek's Portfolio" ? title : `${title} · Avishek's Portfolio`;
const avatar = withBase('/profile-avatar-circle.png');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#e9e6da" />
    <link rel="icon" href={`${avatar}?v=3`} type="image/png" sizes="any" />
    <link rel="shortcut icon" href={`${avatar}?v=3`} type="image/png" />
    <link rel="apple-touch-icon" href={`${avatar}?v=3`} />
    <link rel="manifest" href={withBase('/manifest.webmanifest')} />
    <link rel="stylesheet" href={globalStyles} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href={withBase('/')} aria-label="Avishek's Portfolio home">
          <span class="brand__mark" aria-hidden="true">
            <img src={avatar} alt="" />
          </span>
          <span>
            <strong>Avishek's Portfolio</strong>
            <small>{publicOnlyBuild ? 'Project workbench' : 'Local workspace'}</small>
          </span>
        </a>
        <div class="site-actions">
          <a class="site-action" href={withBase('/manage')}>+ Add project</a>
          {!publicOnlyBuild && (
            <div class="local-indicator" title="This portfolio is configured for local use only">
              <span aria-hidden="true"></span>
              Private · localhost
            </div>
          )}
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>Markdown is the record. Git is the history. This interface is the view.</p>
    </footer>
  </body>
</html>
