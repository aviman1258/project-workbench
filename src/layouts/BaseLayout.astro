---
import globalStyles from '../styles/global.css?url';
import { publicOnlyBuild, withBase } from '../lib/projects';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Avishek's Portfolio",
  description = 'A private, local-first record of product ideas, experiments, and shipped work.',
} = Astro.props;
const pageTitle = title === "Avishek's Portfolio" ? title : `${title} · Avishek's Portfolio`;
const avatar = withBase('/profile-avatar-circle.png');

// Business card shown when the avatar is tapped.
const CARD = {
  name: 'Avishek Chandra',
  email: 'achandra1258@gmail.com',
  phone: '720-320-2111',
  certifications: [
    {
      name: 'AWS Certified Cloud Practitioner',
      issuer: 'Amazon Web Services',
      href: 'https://www.credly.com/users/avishek-chandra.d94e59c9',
      badge: withBase('/certs/aws-cloud-practitioner.png'),
    },
    {
      name: 'Datadog Certified: Datadog Fundamentals',
      issuer: 'Datadog',
      href: 'https://www.credly.com/users/avishek-chandra.d94e59c9',
      badge: withBase('/certs/datadog-fundamentals.png'),
    },
  ] as { name: string; issuer: string; href: string; badge: string }[],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#e9e6da" />
    <link rel="icon" href={`${avatar}?v=3`} type="image/png" sizes="any" />
    <link rel="shortcut icon" href={`${avatar}?v=3`} type="image/png" />
    <link rel="apple-touch-icon" href={`${avatar}?v=3`} />
    <link rel="manifest" href={withBase('/manifest.webmanifest')} />
    <link rel="stylesheet" href={globalStyles} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <button type="button" class="brand brand--button" data-card-open aria-label={`Contact card for ${CARD.name}`} title="Contact card">
          <span class="brand__mark" aria-hidden="true">
            <img src={avatar} alt="" />
          </span>
          <span class="brand__text">
            <strong>Avishek's Portfolio</strong>
            <small>{publicOnlyBuild ? 'Project workbench' : 'Local workspace'}</small>
          </span>
        </button>
        <div class="site-actions">
          <button type="button" class="site-action site-action--share" data-share-open>
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><path d="m8.6 10.5 6.8-4M8.6 13.5l6.8 4"></path></svg>
            Share
          </button>
          <a class:list={['site-action', publicOnlyBuild && 'site-action--needs-github']} href={withBase('/manage')}>+ Add project</a>
          {publicOnlyBuild && (
            <button type="button" class="github-status" data-token-open data-connected="none" aria-label="Connections">
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
            </button>
          )}
          {!publicOnlyBuild && (
            <div class="local-indicator" title="This portfolio is configured for local use only">
              <span aria-hidden="true"></span>
              Private · localhost
            </div>
          )}
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>Markdown is the record. Git is the history. This interface is the view.</p>
    </footer>

    {publicOnlyBuild && (
      <dialog class="share-dialog token-dialog" data-token-dialog>
        <h3>Connections</h3>
        <div class="token-dialog__lights">
          <div class="token-dialog__light">
            <span class="token-dialog__dot" data-github-dot data-on="false"></span>
            <div class="token-dialog__light-text">
              <strong>GitHub — editing</strong>
              <p class="remote-editor-hint" data-github-hint-on hidden>Connected — edits commit as aviman1258.</p>
              <p class="remote-editor-hint" data-github-hint-off>
                Not connected.
                <a href="https://github.com/settings/personal-access-tokens" target="_blank" rel="noreferrer">Create a fine-grained PAT ↗</a>
                with <strong>Contents: read and write</strong> on <code>aviman1258/project-workbench</code>
                (add <code>workbench-private</code> for private projects).
              </p>
            </div>
            <button type="button" class="share-dialog__close token-dialog__forget" data-forget-github hidden>Forget</button>
          </div>
          <div class="token-dialog__light">
            <span class="token-dialog__dot" data-ai-dot data-on="false"></span>
            <div class="token-dialog__light-text">
              <strong>AI drafts</strong>
              <p class="remote-editor-hint" data-ai-hint-on hidden>Connected.</p>
              <p class="remote-editor-hint" data-ai-hint-off>
                Not connected.
                <a href="https://platform.claude.com/settings/workspaces/default/keys" target="_blank" rel="noreferrer">Create an Anthropic API key ↗</a>
                (<code>sk-ant-…</code>). OpenAI keys (<code>sk-…</code>) work too.
              </p>
            </div>
            <button type="button" class="share-dialog__close token-dialog__forget" data-forget-ai hidden>Forget</button>
          </div>
        </div>
        <p class="remote-editor-hint">
          Paste either key below — the type is detected automatically. Keys are stored only in this browser.
        </p>
        <input type="password" class="token-dialog__input" data-token-dialog-input autocomplete="off" placeholder="github_pat_… or sk-ant-…" />
        <div data-proxy-row hidden>
          <p class="remote-editor-hint token-dialog__ai-hint">
            OpenAI keys need the repo's <code>proxy/openai-worker.js</code> deployed on Cloudflare Workers
            (OpenAI blocks direct browser calls) — paste the worker URL:
          </p>
          <input type="url" class="token-dialog__input" data-openai-proxy-input autocomplete="off" placeholder="https://your-worker.workers.dev" />
        </div>
        <video class="token-dialog__scanner" data-token-scan-video hidden playsinline muted></video>
        <p class="share-dialog__url" data-token-dialog-status></p>
        <div class="share-dialog__actions">
          <button type="button" class="share-dialog__native" data-token-dialog-save>Save</button>
          <button type="button" class="share-dialog__close" data-token-scan>Scan QR</button>
          <button type="button" class="share-dialog__close" data-token-dialog-close>Close</button>
        </div>
      </dialog>
    )}

    <dialog class="share-dialog business-card" data-card-dialog>
      <div class="business-card__head">
        <img src={avatar} alt="" />
        <div>
          <h3>{CARD.name}</h3>
          <p>Product &amp; engineering</p>
        </div>
      </div>
      <div class="business-card__rows">
        <a href={`mailto:${CARD.email}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-10 6L2 7"></path></svg>
          {CARD.email}
        </a>
        <a href={`tel:+1${CARD.phone.replaceAll('-', '')}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92Z"></path></svg>
          {CARD.phone}
        </a>
      </div>
      {CARD.certifications.length > 0 && (
        <div class="business-card__certs">
          <h4>Certifications</h4>
          {CARD.certifications.map((cert) => (
            <a href={cert.href} target="_blank" rel="noreferrer">
              <img src={cert.badge} alt="" loading="lazy" />
              <span class="business-card__cert-text">
                <strong>{cert.name}</strong>
                <span>{cert.issuer}</span>
              </span>
            </a>
          ))}
        </div>
      )}
      <div class="share-dialog__actions">
        <button type="button" class="share-dialog__close" data-card-close>Close</button>
      </div>
    </dialog>

    <dialog class="share-dialog" data-share-dialog>
      <h3>Scan to open</h3>
      <canvas data-share-canvas></canvas>
      <p class="share-dialog__url" data-share-url></p>
      <div class="share-dialog__actions">
        <button type="button" class="share-dialog__native" data-share-native hidden>More sharing options…</button>
        <button type="button" class="share-dialog__close" data-share-close>Close</button>
      </div>
    </dialog>

    <script>
      import QRCode from 'qrcode';
      import { TOKEN_EVENT, clearToken, getStoredToken, storeToken, validateToken } from '../lib/github-client';
      import { clearAnthropicKey, clearOpenAiProxy, detectProvider, getStoredAnthropicKey, getStoredOpenAiProxy, storeAnthropicKey, storeOpenAiProxy } from '../lib/ai-complete';

      // --- header connections icon + dialog (hosted builds only) ---
      // One input for every credential; the paste's prefix says what it is.
      const tokenIcon = document.querySelector<HTMLButtonElement>('[data-token-open]');
      const tokenDialog = document.querySelector<HTMLDialogElement>('[data-token-dialog]');
      if (tokenIcon && tokenDialog) {
        // ask the browser not to evict this site's storage (where the keys live)
        try { void navigator.storage?.persist?.(); } catch { /* older browsers */ }
        const q = <T extends HTMLElement>(sel: string) => tokenDialog.querySelector<T>(sel)!;
        const input = q<HTMLInputElement>('[data-token-dialog-input]');
        const status = q('[data-token-dialog-status]');
        const proxyRow = q('[data-proxy-row]');
        const proxyInput = q<HTMLInputElement>('[data-openai-proxy-input]');
        const video = q<HTMLVideoElement>('[data-token-scan-video]');
        const scanButton = q<HTMLButtonElement>('[data-token-scan]');

        const refresh = () => {
          const github = Boolean(getStoredToken());
          const aiKey = getStoredAnthropicKey();
          const openai = Boolean(aiKey) && detectProvider(aiKey) === 'openai';
          tokenIcon.dataset.connected = github && aiKey ? 'all' : github || aiKey ? 'partial' : 'none';
          tokenIcon.title = github && aiKey ? 'GitHub and AI connected'
            : github ? 'GitHub connected — no AI key'
            : aiKey ? 'AI key saved — GitHub not connected'
            : 'Not connected — click to add keys';
          // editing affordances (pencils, Add project) only show while GitHub is connected
          document.body.dataset.githubConnected = String(github);
          q('[data-github-dot]').dataset.on = String(github);
          q('[data-ai-dot]').dataset.on = String(Boolean(aiKey));
          q('[data-github-hint-on]').hidden = !github;
          q('[data-github-hint-off]').hidden = github;
          q('[data-ai-hint-on]').hidden = !aiKey;
          q('[data-ai-hint-off]').hidden = Boolean(aiKey);
          q('[data-ai-hint-on]').textContent = openai
            ? (getStoredOpenAiProxy() ? 'Connected — OpenAI key and proxy saved.' : 'OpenAI key saved — it still needs the proxy URL below.')
            : 'Connected — Anthropic key saved.';
          q('[data-forget-github]').hidden = !github;
          q('[data-forget-ai]').hidden = !aiKey;
          proxyRow.hidden = !openai;
        };
        refresh();
        window.addEventListener(TOKEN_EVENT, refresh);

        // Route a pasted (or scanned) value by its prefix.
        const saveValue = async (raw: string) => {
          const value = raw.trim();
          if (!value) { status.textContent = 'Paste a key first.'; return; }
          if (/^(github_pat_|ghp_|gho_)/.test(value)) {
            status.textContent = 'Checking GitHub access…';
            try {
              await validateToken(value);
              storeToken(value);
              status.textContent = 'GitHub connected.';
            } catch (error) {
              status.textContent = (error as Error).message || 'That token did not work.';
              return;
            }
          } else if (value.startsWith('sk-')) {
            storeAnthropicKey(value);
            status.textContent = detectProvider(value) === 'anthropic'
              ? 'Anthropic key saved.'
              : 'OpenAI key saved — it needs the proxy URL below.';
          } else if (/^https:\/\//.test(value)) {
            storeOpenAiProxy(value);
            status.textContent = 'Proxy URL saved.';
          } else {
            status.textContent = "That doesn't look like a GitHub PAT (github_pat_…) or an AI key (sk-…).";
            return;
          }
          input.value = '';
          refresh();
        };

        tokenIcon.addEventListener('click', () => { status.textContent = ''; refresh(); tokenDialog.showModal(); });
        q('[data-token-dialog-close]').addEventListener('click', () => tokenDialog.close());
        tokenDialog.addEventListener('click', (event) => { if (event.target === tokenDialog) tokenDialog.close(); });
        q('[data-forget-github]').addEventListener('click', () => { clearToken(); status.textContent = 'GitHub token forgotten.'; refresh(); });
        q('[data-forget-ai]').addEventListener('click', () => { clearAnthropicKey(); clearOpenAiProxy(); status.textContent = 'AI key (and proxy) forgotten.'; refresh(); });
        q('[data-token-dialog-save]').addEventListener('click', async () => {
          const proxyCandidate = proxyInput.value.trim();
          if (proxyCandidate) { storeOpenAiProxy(proxyCandidate); proxyInput.value = ''; refresh(); }
          if (input.value.trim()) await saveValue(input.value);
          else if (proxyCandidate) status.textContent = 'Proxy URL saved.';
          else status.textContent = 'Paste a key first.';
        });

        // --- QR scan: read a key straight off another screen ---
        let scanStream: MediaStream | null = null;
        let scanRaf = 0;
        const stopScan = () => {
          cancelAnimationFrame(scanRaf);
          scanStream?.getTracks().forEach((track) => track.stop());
          scanStream = null;
          video.hidden = true;
          video.srcObject = null;
          scanButton.textContent = 'Scan QR';
        };
        tokenDialog.addEventListener('close', stopScan);
        scanButton.addEventListener('click', async () => {
          if (scanStream) { stopScan(); status.textContent = ''; return; }
          try {
            scanStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } });
          } catch {
            status.textContent = 'Camera unavailable — allow camera access, or paste the key instead.';
            return;
          }
          video.srcObject = scanStream;
          video.hidden = false;
          await video.play().catch(() => {});
          scanButton.textContent = 'Stop scan';
          status.textContent = 'Point the camera at the QR code…';
          const onDecoded = (text: string) => { stopScan(); void saveValue(text); };
          const Detector = (window as any).BarcodeDetector;
          if (Detector) {
            const detector = new Detector({ formats: ['qr_code'] });
            const tick = async () => {
              if (!scanStream) return;
              try {
                const codes = await detector.detect(video);
                if (codes.length && codes[0].rawValue) return onDecoded(codes[0].rawValue);
              } catch { /* frame not ready yet */ }
              scanRaf = requestAnimationFrame(() => void tick());
            };
            void tick();
          } else {
            const { default: jsQR } = await import('jsqr');
            const frame = document.createElement('canvas');
            const ctx = frame.getContext('2d', { willReadFrequently: true })!;
            const tick = () => {
              if (!scanStream) return;
              if (video.videoWidth) {
                frame.width = video.videoWidth;
                frame.height = video.videoHeight;
                ctx.drawImage(video, 0, 0);
                const image = ctx.getImageData(0, 0, frame.width, frame.height);
                const code = jsQR(image.data, image.width, image.height);
                if (code?.data) return onDecoded(code.data);
              }
              scanRaf = requestAnimationFrame(tick);
            };
            tick();
          }
        });
      }

      // The QR always points at the hosted site, even from local dev —
      // sharing a localhost address helps nobody.
      const SHARE_ORIGIN = 'https://www.avisheksportfolio.com';

      // --- business card (avatar tap) ---
      const cardDialog = document.querySelector<HTMLDialogElement>('[data-card-dialog]');
      document.querySelector('[data-card-open]')?.addEventListener('click', () => cardDialog?.showModal());
      document.querySelector('[data-card-close]')?.addEventListener('click', () => cardDialog?.close());
      cardDialog?.addEventListener('click', (event) => { if (event.target === cardDialog) cardDialog.close(); });

      const dialog = document.querySelector<HTMLDialogElement>('[data-share-dialog]');
      const canvas = document.querySelector<HTMLCanvasElement>('[data-share-canvas]');
      const urlLabel = document.querySelector<HTMLElement>('[data-share-url]');
      const nativeButton = document.querySelector<HTMLButtonElement>('[data-share-native]');

      const shareUrl = () => {
        const base = import.meta.env.BASE_URL.replace(/\/$/, '');
        const path = window.location.pathname.startsWith(base)
          ? window.location.pathname.slice(base.length)
          : window.location.pathname;
        return `${SHARE_ORIGIN}${path === '/' ? '' : path}`;
      };

      document.querySelector('[data-share-open]')?.addEventListener('click', async () => {
        if (!dialog || !canvas) return;
        const url = shareUrl();
        const size = Math.min(Math.floor(window.innerWidth * 0.78), 440);
        await QRCode.toCanvas(canvas, url, {
          width: size,
          margin: 2,
          errorCorrectionLevel: 'M',
          color: { dark: '#17231e', light: '#ffffff' },
        });
        if (urlLabel) urlLabel.textContent = url;
        if (nativeButton) nativeButton.hidden = !navigator.share;
        dialog.showModal();
      });

      nativeButton?.addEventListener('click', () => {
        void navigator.share({ title: "Avishek's Project Workbench", url: shareUrl() }).catch(() => {});
      });
      document.querySelector('[data-share-close]')?.addEventListener('click', () => dialog?.close());
      dialog?.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
    </script>
  </body>
</html>
