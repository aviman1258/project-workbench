---
import globalStyles from '../styles/global.css?url';
import { publicOnlyBuild, withBase } from '../lib/projects';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Avishek's Portfolio",
  description = 'A private, local-first record of product ideas, experiments, and shipped work.',
} = Astro.props;
const pageTitle = title === "Avishek's Portfolio" ? title : `${title} · Avishek's Portfolio`;
const avatar = withBase('/profile-avatar-circle.png');

// Business card shown when the avatar is tapped.
const CARD = {
  name: 'Avishek Chandra',
  email: 'achandra1258@gmail.com',
  phone: '720-320-2111',
  certifications: [
    {
      name: 'AWS Certified Cloud Practitioner',
      issuer: 'Amazon Web Services',
      href: 'https://www.credly.com/users/avishek-chandra.d94e59c9',
      badge: withBase('/certs/aws-cloud-practitioner.png'),
    },
    {
      name: 'Datadog Certified: Datadog Fundamentals',
      issuer: 'Datadog',
      href: 'https://www.credly.com/users/avishek-chandra.d94e59c9',
      badge: withBase('/certs/datadog-fundamentals.png'),
    },
  ] as { name: string; issuer: string; href: string; badge: string }[],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#e9e6da" />
    <link rel="icon" href={`${avatar}?v=3`} type="image/png" sizes="any" />
    <link rel="shortcut icon" href={`${avatar}?v=3`} type="image/png" />
    <link rel="apple-touch-icon" href={`${avatar}?v=3`} />
    <link rel="manifest" href={withBase('/manifest.webmanifest')} />
    <link rel="stylesheet" href={globalStyles} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <button type="button" class="brand brand--button" data-card-open aria-label={`Contact card for ${CARD.name}`} title="Contact card">
          <span class="brand__mark" aria-hidden="true">
            <img src={avatar} alt="" />
          </span>
          <span class="brand__text">
            <strong>Avishek's Portfolio</strong>
            <small>{publicOnlyBuild ? 'Project workbench' : 'Local workspace'}</small>
          </span>
        </button>
        <div class="site-actions">
          <button type="button" class="site-action site-action--share" data-share-open>
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><path d="m8.6 10.5 6.8-4M8.6 13.5l6.8 4"></path></svg>
            Share
          </button>
          <a class:list={['site-action', publicOnlyBuild && 'site-action--needs-github']} href={withBase('/manage')}>+ Add project</a>
          {publicOnlyBuild && (
            <button type="button" class="github-status" data-token-open data-connected="false" aria-label="GitHub connection">
              <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path></svg>
            </button>
          )}
          {!publicOnlyBuild && (
            <div class="local-indicator" title="This portfolio is configured for local use only">
              <span aria-hidden="true"></span>
              Private · localhost
            </div>
          )}
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>Markdown is the record. Git is the history. This interface is the view.</p>
    </footer>

    {publicOnlyBuild && (
      <dialog class="share-dialog token-dialog" data-token-dialog>
        <h3>GitHub connection</h3>
        <p class="remote-editor-hint" data-token-dialog-state>Not connected.</p>
        <p class="remote-editor-hint">
          Paste a fine-grained personal access token with <strong>Contents: read and write</strong> on
          <code>aviman1258/project-workbench</code> (add <code>workbench-private</code> for private projects).
          It is stored only in this browser.
          <a href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noreferrer">Create one on GitHub ↗</a>
        </p>
        <input type="password" class="token-dialog__input" data-token-dialog-input autocomplete="off" placeholder="github_pat_…" />
        <p class="remote-editor-hint token-dialog__ai-hint">
          <strong>AI drafts (optional):</strong> paste an
          <a href="https://console.anthropic.com/settings/keys" target="_blank" rel="noreferrer">Anthropic ↗</a>
          (<code>sk-ant-…</code>) or
          <a href="https://platform.openai.com/api-keys" target="_blank" rel="noreferrer">OpenAI ↗</a>
          (<code>sk-…</code>) API key — the provider is detected automatically.
        </p>
        <input type="password" class="token-dialog__input" data-anthropic-key-input autocomplete="off" placeholder="sk-ant-… or sk-…" />
        <p class="remote-editor-hint token-dialog__ai-hint">
          OpenAI keys additionally need the repo's <code>proxy/openai-worker.js</code> deployed on Cloudflare Workers
          (OpenAI blocks direct browser calls) — paste the worker URL here. Anthropic keys need no proxy.
        </p>
        <input type="url" class="token-dialog__input" data-openai-proxy-input autocomplete="off" placeholder="https://your-worker.workers.dev (OpenAI keys only)" />
        <p class="share-dialog__url" data-token-dialog-status></p>
        <div class="share-dialog__actions">
          <button type="button" class="share-dialog__native" data-token-dialog-save>Connect</button>
          <button type="button" class="share-dialog__close token-dialog__forget" data-token-dialog-forget hidden>Forget token</button>
          <button type="button" class="share-dialog__close" data-token-dialog-close>Close</button>
        </div>
      </dialog>
    )}

    <dialog class="share-dialog business-card" data-card-dialog>
      <div class="business-card__head">
        <img src={avatar} alt="" />
        <div>
          <h3>{CARD.name}</h3>
          <p>Product &amp; engineering</p>
        </div>
      </div>
      <div class="business-card__rows">
        <a href={`mailto:${CARD.email}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-10 6L2 7"></path></svg>
          {CARD.email}
        </a>
        <a href={`tel:+1${CARD.phone.replaceAll('-', '')}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92Z"></path></svg>
          {CARD.phone}
        </a>
      </div>
      {CARD.certifications.length > 0 && (
        <div class="business-card__certs">
          <h4>Certifications</h4>
          {CARD.certifications.map((cert) => (
            <a href={cert.href} target="_blank" rel="noreferrer">
              <img src={cert.badge} alt="" loading="lazy" />
              <span class="business-card__cert-text">
                <strong>{cert.name}</strong>
                <span>{cert.issuer}</span>
              </span>
            </a>
          ))}
        </div>
      )}
      <div class="share-dialog__actions">
        <button type="button" class="share-dialog__close" data-card-close>Close</button>
      </div>
    </dialog>

    <dialog class="share-dialog" data-share-dialog>
      <h3>Scan to open</h3>
      <canvas data-share-canvas></canvas>
      <p class="share-dialog__url" data-share-url></p>
      <div class="share-dialog__actions">
        <button type="button" class="share-dialog__native" data-share-native hidden>More sharing options…</button>
        <button type="button" class="share-dialog__close" data-share-close>Close</button>
      </div>
    </dialog>

    <script>
      import QRCode from 'qrcode';
      import { TOKEN_EVENT, clearToken, getStoredToken, storeToken, validateToken } from '../lib/github-client';
      import { clearAnthropicKey, clearOpenAiProxy, getStoredAnthropicKey, getStoredOpenAiProxy, storeAnthropicKey, storeOpenAiProxy } from '../lib/ai-complete';

      // --- header GitHub connection icon + token dialog (hosted builds only) ---
      const tokenIcon = document.querySelector<HTMLButtonElement>('[data-token-open]');
      const tokenDialog = document.querySelector<HTMLDialogElement>('[data-token-dialog]');
      if (tokenIcon && tokenDialog) {
        // ask the browser not to evict this site's storage (where the token lives)
        try { void navigator.storage?.persist?.(); } catch { /* older browsers */ }
        const stateLabel = tokenDialog.querySelector<HTMLElement>('[data-token-dialog-state]')!;
        const input = tokenDialog.querySelector<HTMLInputElement>('[data-token-dialog-input]')!;
        const status = tokenDialog.querySelector<HTMLElement>('[data-token-dialog-status]')!;
        const forgetButton = tokenDialog.querySelector<HTMLButtonElement>('[data-token-dialog-forget]')!;

        const refresh = () => {
          const connected = Boolean(getStoredToken());
          tokenIcon.dataset.connected = String(connected);
          tokenIcon.title = connected ? 'GitHub connected' : 'Not connected to GitHub — click to add a token';
          stateLabel.textContent = connected ? 'Connected — edits commit as aviman1258.' : 'Not connected. Editing needs a token.';
          forgetButton.hidden = !connected;
          // editing affordances (pencils) only show while connected
          document.body.dataset.githubConnected = String(connected);
        };
        refresh();
        window.addEventListener(TOKEN_EVENT, refresh);

        tokenIcon.addEventListener('click', () => { status.textContent = ''; tokenDialog.showModal(); });
        tokenDialog.querySelector('[data-token-dialog-close]')?.addEventListener('click', () => tokenDialog.close());
        tokenDialog.addEventListener('click', (event) => { if (event.target === tokenDialog) tokenDialog.close(); });
        forgetButton.addEventListener('click', () => { clearToken(); clearAnthropicKey(); clearOpenAiProxy(); status.textContent = 'Token, AI key, and proxy forgotten.'; });
        const anthropicInput = tokenDialog.querySelector<HTMLInputElement>('[data-anthropic-key-input]')!;
        anthropicInput.placeholder = getStoredAnthropicKey() ? 'AI key saved — paste to replace' : 'sk-ant-… or sk-…';
        const proxyInput = tokenDialog.querySelector<HTMLInputElement>('[data-openai-proxy-input]')!;
        if (getStoredOpenAiProxy()) proxyInput.placeholder = 'Proxy saved — paste to replace';
        tokenDialog.querySelector('[data-token-dialog-save]')?.addEventListener('click', async () => {
          const candidate = input.value.trim();
          const anthropicCandidate = anthropicInput.value.trim();
          if (anthropicCandidate) {
            storeAnthropicKey(anthropicCandidate);
            anthropicInput.value = '';
            anthropicInput.placeholder = 'AI key saved — paste to replace';
          }
          const proxyCandidate = proxyInput.value.trim();
          if (proxyCandidate) {
            storeOpenAiProxy(proxyCandidate);
            proxyInput.value = '';
            proxyInput.placeholder = 'Proxy saved — paste to replace';
          }
          if (!candidate) {
            status.textContent = anthropicCandidate ? 'AI key saved.' : 'Paste a token first.';
            return;
          }
          status.textContent = 'Checking access…';
          try {
            await validateToken(candidate);
            storeToken(candidate);
            input.value = '';
            status.textContent = anthropicCandidate ? 'Connected, AI key saved.' : 'Connected.';
          } catch (error) {
            status.textContent = (error as Error).message || 'That token did not work.';
          }
        });
      }

      // The QR always points at the hosted site, even from local dev —
      // sharing a localhost address helps nobody.
      const SHARE_ORIGIN = 'https://aviman1258.github.io/project-workbench';

      // --- business card (avatar tap) ---
      const cardDialog = document.querySelector<HTMLDialogElement>('[data-card-dialog]');
      document.querySelector('[data-card-open]')?.addEventListener('click', () => cardDialog?.showModal());
      document.querySelector('[data-card-close]')?.addEventListener('click', () => cardDialog?.close());
      cardDialog?.addEventListener('click', (event) => { if (event.target === cardDialog) cardDialog.close(); });

      const dialog = document.querySelector<HTMLDialogElement>('[data-share-dialog]');
      const canvas = document.querySelector<HTMLCanvasElement>('[data-share-canvas]');
      const urlLabel = document.querySelector<HTMLElement>('[data-share-url]');
      const nativeButton = document.querySelector<HTMLButtonElement>('[data-share-native]');

      const shareUrl = () => {
        const base = import.meta.env.BASE_URL.replace(/\/$/, '');
        const path = window.location.pathname.startsWith(base)
          ? window.location.pathname.slice(base.length)
          : window.location.pathname;
        return `${SHARE_ORIGIN}${path === '/' ? '' : path}`;
      };

      document.querySelector('[data-share-open]')?.addEventListener('click', async () => {
        if (!dialog || !canvas) return;
        const url = shareUrl();
        const size = Math.min(Math.floor(window.innerWidth * 0.78), 440);
        await QRCode.toCanvas(canvas, url, {
          width: size,
          margin: 2,
          errorCorrectionLevel: 'M',
          color: { dark: '#17231e', light: '#ffffff' },
        });
        if (urlLabel) urlLabel.textContent = url;
        if (nativeButton) nativeButton.hidden = !navigator.share;
        dialog.showModal();
      });

      nativeButton?.addEventListener('click', () => {
        void navigator.share({ title: "Avishek's Project Workbench", url: shareUrl() }).catch(() => {});
      });
      document.querySelector('[data-share-close]')?.addEventListener('click', () => dialog?.close());
      dialog?.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
    </script>
  </body>
</html>
